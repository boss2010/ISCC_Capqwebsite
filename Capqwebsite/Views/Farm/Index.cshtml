@model List<ViewModels.FarmStopVM>
@{
    var langCookies = Context.Request.Cookies.FirstOrDefault(c => c.Key == "Lang").Value;
    var lang = string.IsNullOrEmpty(langCookies) ? "ar" : langCookies;
}

<!-- Page Header -->
<div class="gov-page-header">
    <div class="container">
        <div class="gov-page-header__inner">
            <div class="gov-page-header__title">
                <span class="gov-page-header__icon"><i class="fas fa-tractor"></i></span>
                <div>
                    <span class="gov-page-header__eyebrow">خدمات التصدير</span>
                    <h1 class="gov-page-header__h1">المزارع الموقوفة</h1>
                </div>
            </div>
            <nav class="gov-breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="gov-breadcrumb__link">الرئيسية</a>
                <i class="fas fa-chevron-left gov-breadcrumb__sep"></i>
                <span class="gov-breadcrumb__current">المزارع الموقوفة</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid gov-inner-page">
    <div class="container">
        <!-- Search Card -->
        <div class="gov-form-card mb-4">
            <div class="gov-form-card__header">
                <span class="gov-form-card__icon"><i class="fas fa-search"></i></span>
                <h2 class="gov-form-card__title">بحث عن مزرعة</h2>
            </div>
            <div class="gov-form-card__body">
                <form class="row align-items-end" method="get">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label class="gov-label">كود المزرعة</label>
                        <input type="text" name="FarmCode" id="FarmCode" class="form-control" placeholder="أدخل كود المزرعة" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" id="btnsearch" name="btnSave" class="btn btn-primary">
                            <i class="fas fa-search ml-1"></i> بحث
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Results Table -->
        <div class="gov-table-card">
            <div class="gov-table-card__header">
                <span class="gov-form-card__icon"><i class="fas fa-list"></i></span>
                <h2 class="gov-form-card__title">نتائج البحث</h2>
            </div>
            <div class="gov-table-card__body">
                <div class="table-responsive" id="divdata">
                    @if (Model != null)
                    {
                        <partial name="_PartialFarm.cshtml" for="@Model" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>
