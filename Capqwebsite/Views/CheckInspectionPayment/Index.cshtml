<!-- Page Header -->
<div class="gov-page-header">
    <div class="container">
        <div class="gov-page-header__inner">
            <div class="gov-page-header__title">
                <span class="gov-page-header__icon"><i class="fas fa-edit"></i></span>
                <div>
                    <span class="gov-page-header__eyebrow">الدفع</span>
                    <h1 class="gov-page-header__h1">اعادة مراجعة الحساب الخاص</h1>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid gov-inner-page">
    <div class="container">


        <!-- Add Form Card -->
        <div class="gov-form-card mb-4">
            <div class="gov-form-card__header">
                <span class="gov-form-card__icon"><i class="fas fa-clipboard-check"></i></span>
                <h2 class="gov-form-card__title">مراجعة الحساب الخاص</h2>
            </div>
            <div class="gov-form-card__body">

<form asp-action="Check" method="post" id="paymentFormCheck">
    <div class="row">
        <div class="col-md-4">
                            <div class="form-group">
                                <label class="gov-label">الرقم القومي</label>
                                <input type="text"
                                       name="National_ID"
                                       id="National_ID"
                                       class="form-control"
                                       value="@ViewBag.National_ID"
                                       maxlength="14"
                                       required
                                       pattern="\d{14}" />
                                <span id="nationalError" class="text-danger"></span>
                            </div>
        </div>

        <div class="col-md-4"></div>

        </div>
                    <div class="gov-form-actions">
                        <button id="btnmodel" class=" md:inline-flex  items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors services btn-pay" type="submit">
                            <i class="fas fa-clipboard-check"></i>مراجعة
                        </button>
                    </div>
        </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        $("#paymentFormCheck").on("submit", function (e) {

            let valid = true;

            $("#nationalError").text("");

            let national = $("#National_ID").val().trim();

            if (national.length !== 14 || !/^\d+$/.test(national)) {

                $("#nationalError").text(
                    "الرقم القومي يجب أن يكون 14 رقم"
                );

                valid = false;
            }

            if (!valid) {
                e.preventDefault();
            }

        });


        $("#National_ID").on("input", function () {

            this.value = this.value
                .replace(/\D/g, "")
                .slice(0, 14);

        });

    </script>
}