@using System.Text.RegularExpressions
@using System.Web
@model List<EF.Models.WebsiteTypeDetail>

<!-- =========================
     Page Header
     ========================= -->

<div class="gov-page-header">
    <div class="container">
        <div class="gov-page-header__inner">

            <div class="gov-page-header__title">

                <span class="gov-page-header__icon">
                    <i class="fas fa-map-marker-alt"></i>
                </span>

                <div>
                    <span class="gov-page-header__eyebrow">
                        شبكة مكاتبنا
                    </span>

                    <h1 class="gov-page-header__h1">
                        مكاتب الحجر الزراعي
                    </h1>
                </div>

            </div>


            <nav class="gov-breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="gov-breadcrumb__link">
                    الرئيسية
                </a>

                <i class="fas fa-chevron-left gov-breadcrumb__sep"></i>

                <span class="gov-breadcrumb__current">
                    مكاتبنا
                </span>

            </nav>

        </div>
    </div>
</div>


<!-- =========================
     Offices
     ========================= -->

<div class="container-fluid gov-inner-page">

    <div class="container">

        @if (Model != null && Model.Count > 0)
        {
            <div class="row">

                @foreach (var item in Model)
                {
                    var coordinates = ExtractCoordinates(item.linkURL);

                    string latitude = null;
                    string longitude = null;

                    if (coordinates != null)
                    {
                        latitude = coordinates.Item1;
                        longitude = coordinates.Item2;
                    }


                    <div class="col-md-4 mb-4">

                        <div class="gov-office-card">


                            <!-- =========================
                                 Card Header
                                 ========================= -->

                            <div class="gov-office-card__header">

                                <i class="fas fa-building ml-2"></i>

                                @item.TitleAr

                            </div>


                            <!-- =========================
                                 Card Body
                                 ========================= -->

                            <div class="gov-office-card__body">


                                <div class="gov-office-card__info">


                                    <!-- Address -->
                                    @if (!string.IsNullOrEmpty(item.descAr))
                                    {
                                        <div class="gov-office-card__row">

                                            <span class="gov-office-card__label">

                                                <i class="fas fa-map-marker-alt"></i>

                                                العنوان

                                            </span>

                                            <span class="gov-office-card__value">

                                                @item.descAr

                                            </span>

                                        </div>
                                    }


                                    <!-- Phone -->
                                    @if (!string.IsNullOrEmpty(item.descEn))
                                    {
                                        <div class="gov-office-card__row">

                                            <span class="gov-office-card__label">

                                                <i class="fas fa-phone-alt"></i>

                                                الهاتف

                                            </span>

                                            <span class="gov-office-card__value">

                                                @item.descEn

                                            </span>

                                        </div>
                                    }


                                    <!-- Email -->
                                    @if (!string.IsNullOrEmpty(item.TitleEn))
                                    {
                                        <div class="gov-office-card__row">

                                            <span class="gov-office-card__label">

                                                <i class="fas fa-envelope"></i>

                                                البريد

                                            </span>

                                            <span class="gov-office-card__value">

                                                <a href="mailto:@item.TitleEn">
                                                    @item.TitleEn
                                                </a>

                                            </span>

                                        </div>
                                    }


                                </div>


                                <!-- =========================
                                     MAP
                                     ========================= -->
                                @if (!string.IsNullOrEmpty(item.linkURL))
                                {

                                    if (!string.IsNullOrEmpty(latitude) &&
                                    !string.IsNullOrEmpty(longitude))
                                    {

                                        /*
                                        * رابط Google Maps للفتح
                                        *
                                        * مثال:
                                        * https://www.google.com/maps/search/?api=1&query=30.04396,31.209542
                                        */

                                        var googleMapsUrl =
                                        "https://www.google.com/maps/search/?api=1&query="
                                        + latitude
                                        + ","
                                        + longitude;


                                        /*
                                        * رابط الخريطة داخل الصفحة
                                        */

                                        var embedUrl =
                                        "https://www.google.com/maps?q="
                                        + latitude
                                        + ","
                                        + longitude
                                        + "&z=17"
                                        + "&output=embed";


                                        <div class="gov-office-card__map gov-map-clickable"
                                             data-map-url="@googleMapsUrl"
                                             onclick="openMap(this)"
                                             role="button"
                                             tabindex="0"
                                             title="فتح الموقع على الخريطة">


                                            <!-- Google Map -->

                                            <iframe src="@embedUrl"
                                                    width="100%"
                                                    height="200"
                                                    style="border:0; pointer-events:none;"
                                                    loading="lazy"
                                                    allowfullscreen>
                                            </iframe>


                                            <!-- Overlay -->

                                            <div class="gov-map-overlay">

                                                <div class="gov-map-overlay__content">

                                                    <i class="fas fa-map-marked-alt"></i>

                                                    <span>
                                                        اضغط لفتح الموقع على الخريطة
                                                    </span>

                                                </div>

                                            </div>


                                        </div>

                                    }
                                    else
                                    {

                                        /*
                                        * لو لم نستطع استخراج الإحداثيات
                                        * نستخدم الرابط الأصلي
                                        */

                                        <div class="gov-office-card__map gov-map-clickable"
                                             data-map-url="@item.linkURL"
                                             onclick="openMap(this)"
                                             role="button"
                                             tabindex="0"
                                             title="فتح الموقع على الخريطة">


                                            <iframe src="@item.linkURL"
                                                    width="100%"
                                                    height="200"
                                                    style="border:0; pointer-events:none;"
                                                    loading="lazy"
                                                    allowfullscreen>
                                            </iframe>


                                            <div class="gov-map-overlay">

                                                <div class="gov-map-overlay__content">

                                                    <i class="fas fa-map-marked-alt"></i>

                                                    <span>
                                                        اضغط لفتح الموقع على الخريطة
                                                    </span>

                                                </div>

                                            </div>


                                        </div>

                                    }

                                }


                            </div>

                        </div>

                    </div>

                }

            </div>
        }
        else
        {

            <!-- =========================
                 Empty State
                 ========================= -->

            <div class="gov-empty-state">

                <i class="fas fa-map-marker-alt gov-empty-state__icon"></i>

                <h3>
                    لا توجد مكاتب متاحة حالياً
                </h3>

                <p>
                    لم يتم إضافة أي مكتب بعد.
                </p>

            </div>

        }

    </div>

</div>



<!-- =========================================================
     CSS
     ========================================================= -->

<style>

    /*
         * Map Container
         */

    .gov-map-clickable {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
        border-radius: 6px;
        cursor: pointer;
        background: #eeeeee;
    }


        /*
         * Iframe
         */

        .gov-map-clickable iframe {
            display: block;
            width: 100%;
            height: 200px;
            border: 0;
        }


    /*
         * Overlay
         */

    .gov-map-overlay {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0);
        color: transparent;
        transition: all 0.25s ease;
        pointer-events: none;
    }


    /*
         * Hover
         */

    .gov-map-clickable:hover .gov-map-overlay {
        background: rgba(0, 0, 0, 0.35);
        color: #ffffff;
    }


    /*
         * Overlay Content
         */

    .gov-map-overlay__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.75);
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.25s ease;
    }


    /*
         * Hover Content
         */

    .gov-map-clickable:hover
    .gov-map-overlay__content {
        opacity: 1;
        transform: translateY(0);
    }


    /*
         * Icon
         */

    .gov-map-overlay__content i {
        font-size: 32px;
        margin-bottom: 8px;
    }


    /*
         * Text
         */

    .gov-map-overlay__content span {
        font-size: 14px;
        white-space: nowrap;
    }


    /*
         * Mobile
         */

    @@media (max-width: 767px) {

        .gov-map-clickable {
            height: 200px;
        }


        .gov-map-overlay {
            background: rgba(0, 0, 0, 0.15);
            color: #ffffff;
        }


        .gov-map-overlay__content {
            opacity: 1;
            transform: translateY(0);
        }
    }

</style>



<!-- =========================================================
     JavaScript
     ========================================================= -->

<script>

    /*
     * Open Google Maps
     */

    function openMap(element) {

        if (!element) {
            return;
        }


        var url = element.getAttribute("data-map-url");


        if (!url || url.trim() === "") {
            return;
        }


        /*
         * فتح Google Maps في صفحة جديدة
         */

        window.open(url, "_blank");

    }



    /*
     * Keyboard Support
     */

    document.addEventListener("DOMContentLoaded", function () {

        var maps =
            document.querySelectorAll(".gov-map-clickable");


        maps.forEach(function (map) {

            map.addEventListener("keydown", function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openMap(map);

                }

            });

        });

    });

</script>



<!-- =========================================================
     C# Functions
     ========================================================= -->
@functions
{

    /*
     * ========================================================
     * Extract Coordinates From Google Maps URL
     * ========================================================
     *
     * يدعم:
     *
     * 1 - ll=
     * 2 - q=
     * 3 - query=
     * 4 - @latitude,longitude
     * 5 - !3d latitude !4d longitude
     * 6 - رابط يحتوي على coordinates مباشرة
     *
     */

    public Tuple<string, string> ExtractCoordinates(string url)
    {

        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }


        try
        {

            /*
             * ==========================================
             * Decode URL
             * ==========================================
             */

            var decodedUrl = HttpUtility.UrlDecode(url);


            /*
             * ==========================================
             * 1 - ll=
             *
             * مثال:
             *
             * https://www.google.com/maps?
             * ll=30.04396,31.209542
             *
             * ==========================================
             */

            var match = Regex.Match(
                decodedUrl,
                @"(?:[?&])ll=([-+]?\d+(?:\.\d+)?),\s*([-+]?\d+(?:\.\d+)?)",
                RegexOptions.IgnoreCase
            );


            if (match.Success)
            {

                return Tuple.Create(
                    match.Groups[1].Value,
                    match.Groups[2].Value
                );

            }


            /*
             * ==========================================
             * 2 - q=
             *
             * مثال:
             *
             * ?q=30.04396,31.209542
             *
             * ==========================================
             */

            match = Regex.Match(
                decodedUrl,
                @"(?:[?&])q=([-+]?\d+(?:\.\d+)?),\s*([-+]?\d+(?:\.\d+)?)",
                RegexOptions.IgnoreCase
            );


            if (match.Success)
            {

                return Tuple.Create(
                    match.Groups[1].Value,
                    match.Groups[2].Value
                );

            }


            /*
             * ==========================================
             * 3 - query=
             *
             * مثال:
             *
             * ?query=30.04396,31.209542
             *
             * ==========================================
             */

            match = Regex.Match(
                decodedUrl,
                @"(?:[?&])query=([-+]?\d+(?:\.\d+)?),\s*([-+]?\d+(?:\.\d+)?)",
                RegexOptions.IgnoreCase
            );


            if (match.Success)
            {

                return Tuple.Create(
                    match.Groups[1].Value,
                    match.Groups[2].Value
                );

            }


            /*
             * ==========================================
             * 4 - @latitude,longitude
             *
             * مثال:
             *
             * /@30.04396,31.209542,19z
             *
             * ==========================================
             */

            match = Regex.Match(
                decodedUrl,
                @"@([-+]?\d+(?:\.\d+)?),\s*([-+]?\d+(?:\.\d+)?)",
                RegexOptions.IgnoreCase
            );


            if (match.Success)
            {

                return Tuple.Create(
                    match.Groups[1].Value,
                    match.Groups[2].Value
                );

            }


            /*
             * ==========================================
             * 5 - !3d latitude !4d longitude
             *
             * مثال:
             *
             * !3d30.04396!4d31.209542
             *
             * ==========================================
             */

            match = Regex.Match(
                decodedUrl,
                @"!3d([-+]?\d+(?:\.\d+)?)!4d([-+]?\d+(?:\.\d+)?)",
                RegexOptions.IgnoreCase
            );


            if (match.Success)
            {

                return Tuple.Create(
                    match.Groups[1].Value,
                    match.Groups[2].Value
                );

            }


            /*
             * ==========================================
             * 6 - Coordinates مباشرة
             *
             * مثال:
             *
             * 30.04396,31.209542
             *
             * ==========================================
             */

            match = Regex.Match(
                decodedUrl,
                @"([-+]?\d{1,3}\.\d+),\s*([-+]?\d{1,3}\.\d+)"
            );


            if (match.Success)
            {

                return Tuple.Create(
                    match.Groups[1].Value,
                    match.Groups[2].Value
                );

            }

        }
        catch
        {

            /*
             * Ignore errors
             */

        }


        return null;

    }

}
