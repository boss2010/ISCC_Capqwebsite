
@model List<EF.Models.WebsiteTypeDetail>
<link rel="stylesheet" href="~/css/agriculture-law-page.css"   />
@if (Context.Request.Query["ID"] == "1")
{
    <partial name="_LawPage" model="Model" />
}
else
{
    @await Html.PartialAsync("_CapqPageBanner", (string)(ViewBag.TypeAr ?? "التشريعات والقوانين"))

    <div class="container-fluid gov-inner-page">
        <div class="container">
            <div class="mx-auto max-w-7xl px-6">

                @if (Model != null && Model.Count > 0)
                {
                    var typeId = Model.FirstOrDefault()?.WebsitetypeID;

                    @* فيديوهات يوتيوب *@
                    if (typeId == 16 || typeId == 15 || typeId == 14 || typeId == 6)
                    {
                        <div class="row">
                            @foreach (var item in Model)
                            {
                                if (!string.IsNullOrEmpty(item.linkURL))
                                {
                                    var embedUrl = item.linkURL.Contains("watch?v=")
                                    ? item.linkURL.Replace("watch?v=", "embed/").Split('&')[0]
                                    : item.linkURL;

                                    <div class="col-md-4 mb-4">
                                        <div class="gov-video-card card">
                                            <div class="gov-video-card__frame">
                                                <iframe src="@embedUrl"
                                                        frameborder="0"
                                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                        allowfullscreen></iframe>
                                            </div>

                                            <div class="card-body p-3">
                                                <h5 class="mb-2">@item.TitleAr</h5>

                                                <a href="@item.linkURL"
                                                   class="btn btn-primary btn-sm"
                                                   target="_blank">
                                                    <i class="fab fa-youtube ml-1"></i>
                                                    مشاهدة على يوتيوب
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @* صفحة اتصل بنا من التشريعات (ID=17) *@
                    else if (typeId == 17)
                    {
                        @foreach (var item in Model)
                        {
                            <div class="row">

                                <div class="col-lg-5 mb-4">
                                    <div class="gov-contact-info-card">

                                        <div class="gov-contact-info-card__item">
                                            <div class="gov-contact-info-card__icon">
                                                <i class="fas fa-map-marker-alt"></i>
                                            </div>

                                            <div>
                                                <h5>العنوان</h5>
                                                <p>@item.TitleAr</p>
                                            </div>
                                        </div>

                                        <div class="gov-contact-info-card__item">
                                            <div class="gov-contact-info-card__icon">
                                                <i class="fas fa-envelope"></i>
                                            </div>

                                            <div>
                                                <h5>البريد الإلكتروني</h5>
                                                <p>@item.TitleEn</p>
                                            </div>
                                        </div>

                                        <div class="gov-contact-info-card__item">
                                            <div class="gov-contact-info-card__icon">
                                                <i class="fas fa-phone-alt"></i>
                                            </div>

                                            <div>
                                                <h5>أرقام السويتش</h5>
                                                <p>@item.descEn</p>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-lg-7 mb-4">
                                    <div class="gov-map-card">

                                        <div class="gov-map-card__header">
                                            <i class="fas fa-map ml-2"></i>
                                            الموقع الجغرافي
                                        </div>

                                        <iframe src="@item.linkURL"
                                                width="100%"
                                                height="400"
                                                style="border:0; display:block;"
                                                loading="lazy"
                                                allowfullscreen="">
                                        </iframe>

                                    </div>
                                </div>

                            </div>
                        }
                    }

                    @* ملفات PDF *@
                    else
                    {
                        <div class="law-page" dir="rtl">

                            <div class="law-content law-container">

                                <div class="law-intro">
                                    <div>
                                        <h2>@(ViewBag.TypeAr ?? "قوانين وتشريعات الزراعة")</h2>
                                        <p>الوصول السريع إلى القوانين واللوائح والمراجع المتاحة</p>
                                    </div>

                                    <span class="law-counter">
                                        @Model.Count ملف متاح
                                    </span>
                                </div>

                                <div class="law-grid">

                                    @foreach (var item in Model)
                                    {
                                        <article class="law-card">

                                            <div class="law-cover">
                                                <span class="law-file-badge">
                                                    <i class="far fa-file-pdf" aria-hidden="true"></i>
                                                </span>
                                            </div>

                                            <div class="law-card-body">

                                                <h3>@item.TitleAr</h3>

                                                <div class="law-meta">
                                                    <i class="far fa-file-alt" aria-hidden="true"></i>
                                                    قانون
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(item.filepath))
                                                {
                                                    <a href="#"
                                                       class="law-view openPdf"
                                                       data-pdf="@item.filepath">

                                                        <i class="fas fa-eye" aria-hidden="true"></i>
                                                        عرض القانون

                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="law-meta">
                                                        الملف غير متاح حاليًا
                                                    </span>
                                                }

                                            </div>

                                        </article>
                                    }

                                </div>

                                @if (Model == null || Model.Count == 0)
                                {
                                    <p class="law-empty">
                                        لا توجد ملفات متاحة حاليًا.
                                    </p>
                                }

                                <div class="law-notice">

                                    <span class="law-notice-icon" aria-hidden="true">
                                        ✓
                                    </span>

                                    <div>
                                        <h3>منصة تشريعات رقمية أكثر سهولة</h3>

                                        <p>
                                            الوصول إلى القوانين والقرارات والمراجع الزراعية
                                            والاطلاع على ملفاتها الإلكترونية.
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="gov-empty-state">
                        <i class="fas fa-folder-open gov-empty-state__icon"></i>

                        <h3>لا توجد بيانات متاحة حالياً</h3>

                        <p>
                            لم يتم إضافة أي محتوى لهذا القسم بعد.
                        </p>
                    </div>
                }

            </div>
        </div>
    </div>
}

<!-- PDF Modal -->
<div id="pdfModal"
     style="display:none;
            position:fixed;
            top:0;
            left:0;
            width:100%;
            height:100%;
            background:rgba(0,0,0,0.85);
            z-index:9999;
            align-items:center;
            justify-content:center;">

    <div id="closeModal"
         style="position:absolute;
                top:16px;
                left:20px;
                cursor:pointer;
                color:#fff;
                width:40px;
                height:40px;
                background:var(--gov-danger,#b42318);
                border-radius:50%;
                display:flex;
                align-items:center;
                justify-content:center;">

        <i class="fas fa-times"></i>

    </div>

    <iframe id="pdfFrame"
            style="width:min(92vw,1100px);
                   height:min(80vh,760px);
                   margin:6vh auto;
                   display:block;
                   border:none;
                   border-radius:8px;
                   background:#fff;">
    </iframe>

</div>

<script>

    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById("pdfFrame");

    document.getElementById("closeModal").onclick = function () {

        modal.style.display = "none";
        frame.src = "";

    };

    document.querySelectorAll(".openPdf").forEach(l =>

        l.addEventListener("click", function (e) {

            e.preventDefault();

            frame.src = this.getAttribute("data-pdf");

            modal.style.display = "flex";

        })

    );

</script>
  