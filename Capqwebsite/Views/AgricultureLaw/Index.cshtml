
@model List<EF.Models.WebsiteTypeDetail>

<partial name="_LawPage" model="Model" />

<!-- PDF Modal -->
<div id="pdfModal"
     style="display:none;
            position:fixed;
            top:0;
            left:0;
            width:100%;
            height:100%;
            background:rgba(0,0,0,0.85);
            z-index:9999;
            align-items:center;
            justify-content:center;">

    <div id="closeModal"
         style="position:absolute;
                top:16px;
                left:20px;
                cursor:pointer;
                color:#fff;
                width:40px;
                height:40px;
                background:var(--gov-danger,#b42318);
                border-radius:50%;
                display:flex;
                align-items:center;
                justify-content:center;">

        <i class="fas fa-times"></i>

    </div>

    <iframe id="pdfFrame"
            style="width:min(92vw,1100px);
                   height:min(80vh,760px);
                   margin:6vh auto;
                   display:block;
                   border:none;
                   border-radius:8px;
                   background:#fff;">
    </iframe>

</div>

<script>

    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById("pdfFrame");

    document.getElementById("closeModal").onclick = function () {

        modal.style.display = "none";
        frame.src = "";

    };

    document.querySelectorAll(".openPdf").forEach(l =>

        l.addEventListener("click", function (e) {

            e.preventDefault();

            frame.src = this.getAttribute("data-pdf");

            modal.style.display = "flex";

        })

    );

</script>
  
