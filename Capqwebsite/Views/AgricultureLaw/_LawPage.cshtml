@model List<EF.Models.WebsiteTypeDetail>

<link rel="stylesheet"
      href="~/css/agriculture-law-page.css"
      asp-append-version="true" />

@{
    // ID القادم من الرابط
    var queryId = Context.Request.Query["ID"].ToString();

    int.TryParse(queryId, out int currentId);

    // البيانات
    var items = Model ?? new List<EF.Models.WebsiteTypeDetail>();

    // العنوان
    var pageTitle = ViewBag.TypeAr as string;

    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = currentId switch
        {
            1 => "قانون الزراعة",
            2 => "القرارات الوزارية",
            3 => "قوائم الآفات",
            6 => "الفيديوهات",
            14 => "الفيديوهات",
            15 => "الفيديوهات",
            16 => "الفيديوهات",
            17 => "اتصل بنا",
            _ => "التشريعات والقوانين"
        };
    }

    var sectionTitle = currentId switch
    {
        1 => "قوانين وتشريعات الزراعة",
        2 => "القرارات الوزارية",
        3 => "قوائم الآفات",
        17 => "بيانات التواصل",
        6 or 14 or 15 or 16 => "الفيديوهات",
        _ => pageTitle
    };

    var sectionDescription = currentId switch
    {
        1 => "الوصول السريع إلى القوانين واللوائح المنظمة للعمل الزراعي",
        2 => "الوصول السريع إلى القرارات الوزارية المنظمة للعمل الزراعي",
        3 => "الوصول السريع إلى قوائم الآفات والمراجع الزراعية",
        17 => "بيانات التواصل والعنوان والموقع الجغرافي",
        6 or 14 or 15 or 16 => "الوصول إلى الفيديوهات والمحتوى المرئي",
        _ => "الوصول السريع إلى التشريعات والقوانين واللوائح"
    };
}

<div class="law-page" dir="rtl">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <section class="law-page-head">

        <div class="law-container">

            <nav class="law-breadcrumb"
                 aria-label="مسار الصفحة">

                <a href="@Url.Action("Index", "Home")">
                    الرئيسية
                </a>

                <span>›</span>

                <span>@pageTitle</span>

            </nav>


            <div class="law-title-wrap">

                <div>

                    <span>
                        التشريعات والقوانين
                    </span>

                    <h1>
                        @pageTitle
                    </h1>

                </div>


                <div class="law-title-icon">

                    <i class="fas fa-balance-scale"
                       aria-hidden="true">
                    </i>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================= -->
    <!-- CONTENT -->
    <!-- ========================= -->

    <div class="law-content law-container">


        <!-- INTRO -->

        <div class="law-intro">

            <div>

                <h2>
                    @sectionTitle
                </h2>

                <p>
                    @sectionDescription
                </p>

            </div>

            <span class="law-counter">

                @items.Count عنصر متاح

            </span>

        </div>


        <!-- ================================================= -->
        <!-- VIDEOS -->
        <!-- ================================================= -->
        @if (currentId == 6 ||
                currentId == 14 ||
                currentId == 15 ||
                currentId == 16)
        {
            <div class="law-grid">

                @if (items.Any())
                {
                    foreach (var item in items)
                    {
                        if (!string.IsNullOrWhiteSpace(item.linkURL))
                        {
                            var embedUrl = item.linkURL;

                            if (embedUrl.Contains("watch?v="))
                            {
                                embedUrl = embedUrl
                                .Replace("watch?v=", "embed/")
                                .Split('&')[0];
                            }

                            <article class="law-card">

                                <div class="law-cover">

                                    <div style="
                                                        width:100%;
                                                        height:100%;
                                                        min-height:220px;
                                                        display:flex;
                                                        align-items:center;
                                                        justify-content:center;
                                                        background:#f5f5f5;
                                                    ">

                                        <i class="fab fa-youtube"
                                           style="
                                                                font-size:65px;
                                                                color:#d32f2f;
                                                           ">
                                        </i>

                                    </div>

                                </div>


                                <div class="law-card-body">

                                    <h3>
                                        @item.TitleAr
                                    </h3>

                                    <div class="law-meta">

                                        <i class="fab fa-youtube"></i>

                                        فيديو

                                    </div>


                                    <a class="law-view"
                                       href="@item.linkURL"
                                       target="_blank">

                                        <i class="fas fa-play"></i>

                                        مشاهدة الفيديو

                                    </a>

                                </div>

                            </article>
                        }
                    }
                }

            </div>
        }


        <!-- ================================================= -->
        <!-- CONTACT -->
        <!-- ================================================= -->
        else if (currentId == 17)
        {
        <div class="law-grid">

            @if (items.Any())
            {
                foreach (var item in items)
                {
                    <article class="law-card">

                        <div class="law-cover">

                            <span class="law-file-badge">

                                <i class="fas fa-address-card"></i>

                            </span>

                        </div>


                        <div class="law-card-body">

                            <h3>
                                @item.TitleAr
                            </h3>


                            @if (!string.IsNullOrWhiteSpace(item.TitleEn))
                            {
                                <div class="law-meta">

                                    <i class="fas fa-envelope"></i>

                                    @item.TitleEn

                                </div>
                            }


                            @if (!string.IsNullOrWhiteSpace(item.descEn))
                            {
                                <div class="law-meta">

                                    <i class="fas fa-phone"></i>

                                    @item.descEn

                                </div>
                            }


                            @if (!string.IsNullOrWhiteSpace(item.linkURL))
                            {
                                <a class="law-view"
                                   href="@item.linkURL"
                                   target="_blank">

                                    <i class="fas fa-map-marker-alt"></i>

                                    عرض الموقع

                                </a>
                            }

                        </div>

                    </article>
                }
            }

        </div>
        }


        <!-- ================================================= -->
        <!-- PDF / DOCUMENTS -->
        <!-- ================================================= -->
        else
        {
        <div class="law-grid">

            @if (items.Any())
            {
                foreach (var item in items)
                {
                    <article class="law-card">

                        <div class="law-cover">

                            <span class="law-file-badge">

                                <i class="far fa-file-pdf"></i>

                            </span>

                        </div>


                        <div class="law-card-body">

                            <h3>
                                @item.TitleAr
                            </h3>


                            <div class="law-meta">

                                <i class="far fa-file-alt"></i>

                                @pageTitle

                            </div>


                            @if (!string.IsNullOrWhiteSpace(item.filepath))
                            {
                                <a class="law-view openPdf"
                                   href="@item.filepath"
                                   data-pdf="@item.filepath">

                                    <i class="fas fa-eye"></i>

                                    عرض الملف

                                </a>
                            }
                            else
                            {
                                <span class="law-meta">

                                    الملف غير متاح حاليًا

                                </span>
                            }

                        </div>

                    </article>
                }
            }

        </div>
        }


        <!-- ================================================= -->
        <!-- EMPTY -->
        <!-- ================================================= -->
        @if (!items.Any())
        {
            <p class="law-empty">

                لا توجد بيانات متاحة حاليًا.

            </p>
        }


        <!-- ================================================= -->
        <!-- NOTICE -->
        <!-- ================================================= -->

        <div class="law-notice">

            <span class="law-notice-icon">

                ✓

            </span>

            <div>

                <h3>
                    منصة تشريعات رقمية أكثر سهولة
                </h3>

                <p>
                    الوصول إلى القوانين والقرارات والمراجع الزراعية
                    والاطلاع على ملفاتها الإلكترونية.
                </p>

            </div>

        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- PDF MODAL -->
<!-- ================================================= -->

<div id="pdfModal"
     style="
        display:none;
        position:fixed;
        top:0;
        left:0;
        width:100%;
        height:100%;
        background:rgba(0,0,0,.85);
        z-index:99999;
        align-items:center;
        justify-content:center;
     ">

    <div id="closeModal"
         style="
            position:absolute;
            top:16px;
            left:20px;
            cursor:pointer;
            color:#fff;
            width:40px;
            height:40px;
            background:#b42318;
            border-radius:50%;
            display:flex;
            align-items:center;
            justify-content:center;
         ">

        <i class="fas fa-times"></i>

    </div>


    <iframe id="pdfFrame"
            style="
                width:min(92vw,1100px);
                height:min(80vh,760px);
                margin:6vh auto;
                display:block;
                border:none;
                border-radius:8px;
                background:#fff;
            ">
    </iframe>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const modal = document.getElementById("pdfModal");
        const frame = document.getElementById("pdfFrame");
        const closeModal = document.getElementById("closeModal");

        if (!modal || !frame || !closeModal) {
            return;
        }


        closeModal.addEventListener("click", function () {

            modal.style.display = "none";

            frame.src = "";

        });


        document.querySelectorAll(".openPdf")
            .forEach(function (link) {

                link.addEventListener("click", function (e) {

                    e.preventDefault();

                    const pdf =
                        this.getAttribute("data-pdf");

                    if (!pdf) {
                        return;
                    }

                    frame.src = pdf;

                    modal.style.display = "flex";

                });

            });


        modal.addEventListener("click", function (e) {

            if (e.target === modal) {

                modal.style.display = "none";

                frame.src = "";

            }

        });


        document.addEventListener("keydown", function (e) {

            if (e.key === "Escape") {

                modal.style.display = "none";

                frame.src = "";

            }

        });

    });

</script>
