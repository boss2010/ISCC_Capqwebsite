@model List<EF.Models.WebsiteTypeDetail>
<link rel="stylesheet" href="~/css/agriculture-law-page.css" asp-append-version="true" />
<div class="law-page" dir="rtl">
    <section class="law-page-head">
        <div class="law-container">
            <nav class="law-breadcrumb" aria-label="مسار الصفحة"><a href="@Url.Action("Index", "Home")">الرئيسية</a> <span>›</span> قانون الزراعة</nav>
            <div class="law-title-wrap"><div><span>التشريعات والقوانين</span><h1>قانون الزراعة</h1></div><div class="law-title-icon"><i class="fas fa-balance-scale" aria-hidden="true"></i></div></div>
        </div>
    </section>
    <div class="law-content law-container">
        <div class="law-intro"><div><h2>قوانين وتشريعات الزراعة</h2><p>الوصول السريع إلى القوانين واللوائح المنظمة للعمل الزراعي</p></div><span class="law-counter">@(Model?.Count ?? 0) تشريع متاح</span></div>
        <div class="law-grid">
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <article class="law-card">
                        <div class="law-cover"><span class="law-file-badge"><i class="far fa-file-pdf" aria-hidden="true"></i></span></div>
                        <div class="law-card-body"><h3>@item.TitleAr</h3><div class="law-meta"><i class="far fa-file-alt" aria-hidden="true"></i> تشريع زراعي</div>
                            @if (!string.IsNullOrWhiteSpace(item.filepath))
                            {
                                <a class="law-view openPdf" href="@item.filepath" data-pdf="@item.filepath"><i class="fas fa-eye" aria-hidden="true"></i> عرض القانون</a>
                            }
                            else
                            {
                                <span class="law-meta">الملف غير متاح حاليًا</span>
                            }
                        </div>
                    </article>
                }
            }
            <article class="law-card"><div class="law-cover"><span class="law-file-badge"><i class="fas fa-book" aria-hidden="true"></i></span></div><div class="law-card-body"><h3>القرارات الوزارية</h3><div class="law-meta">مرجع · القرارات المنظمة للعمل الزراعي</div><a class="law-view" href="@Url.Action("Index", "AgricultureLaw", new { ID = 2 })"><i class="fas fa-eye" aria-hidden="true"></i> استعراض</a></div></article>
            <article class="law-card"><div class="law-cover"><span class="law-file-badge"><i class="fas fa-seedling" aria-hidden="true"></i></span></div><div class="law-card-body"><h3>قوائم الآفات</h3><div class="law-meta">حجر زراعي · مراجع</div><a class="law-view" href="@Url.Action("Index", "AgricultureLaw", new { ID = 3 })"><i class="fas fa-eye" aria-hidden="true"></i> عرض الملفات</a></div></article>
        </div>
        @if (Model == null || Model.Count == 0) { <p class="law-empty">لا توجد تشريعات متاحة حاليًا.</p> }
        <div class="law-notice"><span class="law-notice-icon" aria-hidden="true">✓</span><div><h3>منصة تشريعات رقمية أكثر سهولة</h3><p>الوصول إلى القوانين والقرارات والمراجع الزراعية والاطلاع على ملفاتها الإلكترونية.</p></div></div>
    </div>
</div>