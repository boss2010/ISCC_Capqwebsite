@{
    ViewData["Title"] = "التحقق من الشهادة الزراعية";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100%;
            background: #eff9f7;
            font-family: Tahoma, Arial, sans-serif;
        }

        .page {
            position: relative;
            width: min(100vw, 1536px);
            margin: 0 auto;
            aspect-ratio: 3 / 2;
            overflow: hidden;
        }

        .reference {
            display: block;
            width: 100%;
            height: 100%;
        }

        .cert-number {
            position: absolute;
            left: 40.36%;
            top: 48.45%;
            width: 34.5%;
            height: 5.66%;
            border: 0;
            outline: 0;
            background: transparent;
            color: #173b34;
            direction: ltr;
            text-align: right;
            padding: 0 2%;
            font: 16px Tahoma, Arial, sans-serif;
        }

            .cert-number::placeholder {
                color: #b9c2c0;
                opacity: 1;
            }

        .verify {
            position: absolute;
            left: 40.36%;
            top: 56.84%;
            width: 34.5%;
            height: 6.25%;
            border: 0;
            border-radius: 10px;
            background: transparent;
            cursor: pointer;
            color: transparent;
            font-size: 1px;
        }

            .verify:focus-visible {
                outline: 3px solid #f5c84c;
                outline-offset: 2px;
            }

        .result {
            display: none;
            position: absolute;
            left: 40.36%;
            top: 63.2%;
            width: 34.5%;
            padding: 6px 10px;
            border-radius: 6px;
            background: #fff;
            color: #173b34;
            font-size: clamp(10px, 1vw, 15px);
            line-height: 1.4;
        }

            .result.show {
                display: block;
            }

            .result.err {
                color: #9b3030;
            }

            .result.ok {
                color: #087a4b;
            }

        .open-cert {
            display: none;
            position: absolute;
            left: 40.36%;
            top: 67.6%;
            width: 34.5%;
            height: 4%;
            border: 0;
            background: transparent;
            cursor: pointer;
            color: transparent;
            font-size: 1px;
        }

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 20;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #000d;
        }

            .modal.open {
                display: flex;
            }

            .modal iframe {
                width: min(92vw, 1100px);
                height: min(84vh, 760px);
                border: 0;
                border-radius: 8px;
                background: white;
            }

        .close {
            position: absolute;
            top: 16px;
            left: 20px;
            width: 44px;
            height: 44px;
            border: 0;
            border-radius: 50%;
            color: white;
            background: #a83a32;
            font-size: 28px;
            cursor: pointer;
        }

        @@media (max-width: 650px) {
            .page {
                width: 100vw;
            }

            .cert-number {
                font-size: clamp(8px, 2.2vw, 16px);
            }

            .result {
                padding: 3px 5px;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <img class="reference" alt="التحقق من الشهادة الزراعية" src="data:image/jpeg;base64," />
        <input id="certNo" class="cert-number" type="text" inputmode="numeric" maxlength="30" aria-label="رقم الشهادة الزراعية" placeholder="مثال: 123456789" />
        <button id="verifyBtn" class="verify" type="button" aria-label="تحقق من الشهادة">تحقق من الشهادة</button>
        <div id="result" class="result" role="status" aria-live="polite"></div>
        <button id="openCertificate" class="open-cert" type="button">عرض الشهادة</button>
    </main>
    <div id="pdfModal" class="modal" role="dialog" aria-modal="true" aria-label="عرض الشهادة">
        <button id="closeModal" class="close" type="button" aria-label="إغلاق">&times;</button>
        <iframe id="pdfFrame" title="عرض ملف الشهادة"></iframe>
    </div>
    <script>
        const verifyButton = document.getElementById("verifyBtn");
        const certificateInput = document.getElementById("certNo");
        const result = document.getElementById("result");
        const openCertificateButton = document.getElementById("openCertificate");
        const modal = document.getElementById("pdfModal");
        const frame = document.getElementById("pdfFrame");
        let certificateUrl = "";

        verifyButton.addEventListener("click", async () => {
            const number = certificateInput.value.trim();
            result.className = "result";
            result.textContent = "";
            openCertificateButton.style.display = "none";
            certificateUrl = "";
            if (!number) {
                result.textContent = "من فضلك أدخلي رقم الشهادة الزراعية.";
                result.classList.add("show", "err");
                return;
            }
            verifyButton.disabled = true;
            try {
                const url = '@Url.Action("GetCertificate", "PhytosanitaryCertificate")' + "?number=" + encodeURIComponent(number);
                const response = await fetch(url);
                const data = await response.json();
                if (!response.ok || !data.success || !data.certificateFile) {
                    result.textContent = data.message || "لم يتم العثور على الشهادة.";
                    result.classList.add("show", "err");
                    return;
                }
                certificateUrl = data.certificateFile;
                result.textContent = "تم العثور على الشهادة رقم " + (data.certificateNumber || number) + " وهي متاحة للعرض.";
                result.classList.add("show", "ok");
                openCertificateButton.style.display = "block";
            } catch (error) {
                result.textContent = "حدث خطأ أثناء التحقق. حاولي مرة أخرى.";
                result.classList.add("show", "err");
                console.error("Certificate verification error:", error);
            } finally {
                verifyButton.disabled = false;
            }
        });
        openCertificateButton.addEventListener("click", () => {
            if (!certificateUrl) return;
            frame.src = certificateUrl;
            modal.classList.add("open");
        });
        function closeModal() { modal.classList.remove("open"); frame.src = ""; }
        document.getElementById("closeModal").addEventListener("click", closeModal);
        modal.addEventListener("click", event => { if (event.target === modal) closeModal(); });
        certificateInput.addEventListener("keydown", event => { if (event.key === "Enter") verifyButton.click(); });
    </script>
</body>
</html>
