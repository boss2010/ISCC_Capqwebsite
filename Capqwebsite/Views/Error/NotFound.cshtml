@{
    ViewData["Title"] = "404 - Not Found";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>404</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0d6efd, #6f42c1);
            color: white;
            text-align: center;
        }

        .box {
            animation: float 2s ease-in-out infinite;
        }

        @@keyframes float {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-15px);
        }

        }

        .code {
            font-size: 120px;
            font-weight: bold;
        }

        .btn-home {
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="box">
        <div class="code">404</div>
        <h2>Oops! الصفحة غير موجودة</h2>
        <p>يمكن الرابط غلط أو الصفحة اتحذفت</p>

        <a href="/" class="btn btn-light btn-lg btn-home">
            رجوع للصفحة الرئيسية
        </a>
    </div>

</body>
</html>