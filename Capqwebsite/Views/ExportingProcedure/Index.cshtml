 @model List<ViewModels.ExportingProcedureVM>
@{
	var langCookies = Context.Request.Cookies.FirstOrDefault(c => c.Key == "Lang").Value;
	var lang = string.IsNullOrEmpty(langCookies) ? "ar" : langCookies;
}

<!-- Page Header Start -->

<div class="gov-page-header">
	<div class="container">
		<div class="gov-page-header__inner">
			<div class="gov-page-header__title">
				<span class="gov-page-header__icon"><i class="fas fa-balance-scale"></i></span>
				<div>
					<span class="gov-page-header__eyebrow"> التصدير </span>
					<h1 class="gov-page-header__h1"> اشترطات التصدير</h1>
				</div>
			</div>
			<nav class="gov-breadcrumb">
				<a href="/Home/HomePage/Index" class="gov-breadcrumb__link">الرئيسية</a>
				<i class="fas fa-chevron-left gov-breadcrumb__sep"></i>
				<span class="gov-breadcrumb__current"> اشترطات التصدير</span>
			</nav>
		</div>
	</div>
</div>
<!-- Page Header Start -->
<!-- Contact Start -->



<div class="container-fluid bg-light">
	<div class="container pt-5">
		<form class="text-start">
			<div class="row">
				<div class="col-md-4">

					<label class="label lbl-style ">المنشأ</label>

					<br>
					<br>
					@* /////////////rrrr_13-5-2025///////////////// *@

					@Html.DropDownList("CountryID", (IEnumerable<SelectListItem>)ViewData["CountryList"], "-- اختار --", new { @id = "ImInitiatorListId", @class = "form-control" })





				</div>
				<div class="col-md-4">

					<label class="label lbl-style ">النباتات</label>

					<br>
					<br>

					@Html.DropDownList("ItemID",(IEnumerable<SelectListItem>)ViewData["ItemList"],"-- اختار --",new { @id = "ItemListId", @class = "form-control" })


				</div>
				<div style="display: none;" class="col-md-4">

					<label class="label lbl-style ">مسمي مختصر</label>

					<br>
					<br>
					<select class="operator form-control">
						<option value="">مسمي مختصر</option>
						<option value="">___</option>
						<option value="">___</option>
						<option value="">__</option>
						<option value="">__</option>
					</select>


				</div>
			</div>
			<br />
			<div class="row">
				<div class="col-md-4"></div>
				<div class="col-md-4">

					<center style="margin-bottom: 15px;">

						<input id="btnsearch" type="submit" class="bg-primary-deep text-primary-foreground py-2 px-4" name="btnSave" value="بحث">
					</center>
				</div>
				<div class="col-md-4"></div>
			</div>
		</form>

		@* //////////////////////////partial view 23/9/2025////////////////////////// *@
		
			<div id="divdata">
				@if (@Model != null)
				{
					<partial name="_PartialExporting.cshtml" for="@Model" />
				}

			</div>
		

	</div>
</div>


<script src="~/js/jquery-3.4.1.min.js"></script>

<script>
	$(document).ready(function () {
		$("#ItemListId").select2({
			placeholder: "-- اختار --",
			allowClear: true
		});
		$("#ImInitiatorListId").select2({
			placeholder: "-- اختار --",
			allowClear: true
		});

			$("#ItemListId").on("change", function () {
		$("#resultsTable").empty();});
				$("#ImInitiatorListId").on("change", function () {
		$("#resultsTable").empty();});
	});


</script>