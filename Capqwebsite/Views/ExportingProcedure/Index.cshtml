@model List<ViewModels.ExportingProcedureVM>

@{
	var langCookies = Context.Request.Cookies.FirstOrDefault(c => c.Key == "Lang").Value;
	var lang = string.IsNullOrEmpty(langCookies) ? "ar" : langCookies;
}

<!-- Page Header Start -->

<div class="gov-page-header">
	<div class="container">
		<div class="gov-page-header__inner">

			<div class="gov-page-header__title">

				<span class="gov-page-header__icon">
					<i class="fas fa-balance-scale"></i>
				</span>

				<div>
					<span class="gov-page-header__eyebrow">
						التصدير
					</span>

					<h1 class="gov-page-header__h1">
						اشتراطات التصدير
					</h1>
				</div>

			</div>

			<nav class="gov-breadcrumb">

				<a href="/Home/HomePage/Index"
				   class="gov-breadcrumb__link">
					الرئيسية
				</a>

				<i class="fas fa-chevron-left gov-breadcrumb__sep"></i>

				<span class="gov-breadcrumb__current">
					اشتراطات التصدير
				</span>

			</nav>

		</div>
	</div>
</div>

<!-- Page Header End -->

<div class="mx-auto max-w-7xl px-6">
<div class="container-fluid bg-light">

	<div class="container pt-5">

		<form id="searchForm" class="text-start">

			<div class="row">

				<!-- الدولة -->
				<div class="col-md-4">

					<label class="label lbl-style">
						المنشأ
					</label>

					<br>
					<br>

					@Html.DropDownList(
					"CountryID",
										(IEnumerable<SelectListItem>)ViewData["CountryList"],
										"-- اختار --",
										new
										{
											@id = "ImInitiatorListId",
											@class = "form-control"
										}
										)

				</div>


				<!-- النباتات -->
				<div class="col-md-4">

					<label class="label lbl-style">
						النباتات
					</label>

					<br>
					<br>

					@Html.DropDownList(
										"ItemID",
										(IEnumerable<SelectListItem>)ViewData["ItemList"],
										"-- اختار --",
										new
										{
											@id = "ItemListId",
											@class = "form-control"
										}
										)

				</div>


				<!-- مسمى مختصر -->
				<div style="display: none;" class="col-md-4">

					<label class="label lbl-style">
						مسمى مختصر
					</label>

					<br>
					<br>

					<select class="operator form-control">

						<option value="">
							مسمى مختصر
						</option>

						<option value="">
							___
						</option>

						<option value="">
							___
						</option>

						<option value="">
							__
						</option>

						<option value="">
							__
						</option>

					</select>

				</div>

			</div>


			<br />


			<div class="row">

				<div class="col-md-4"></div>

				<div class="col-md-4">

					<center style="margin-bottom: 15px;">

						<input id="btnsearch"
							   type="submit"
							   class="bg-primary-deep text-primary-foreground py-2 px-4"
							   name="btnSave"
							   value="بحث">

					</center>

				</div>

				<div class="col-md-4"></div>

			</div>

		</form>


		<!-- النتائج -->

		<div id="divdata">

			@if (Model != null)
			{
				<partial name="_PartialExporting.cshtml" for="@Model" />
			}

		</div>

	</div>

</div>

</div>
<script src="~/js/jquery-3.4.1.min.js"></script>

<script>

	$(document).ready(function () {

		// =====================================================
		// Select2
		// =====================================================

		$("#ItemListId").select2({
			placeholder: "-- اختار --",
			allowClear: true,
			width: "100%"
		});

		$("#ImInitiatorListId").select2({
			placeholder: "-- اختار --",
			allowClear: true,
			width: "100%"
		});


		// =====================================================
		// تغيير الدولة
		// =====================================================

		$("#ImInitiatorListId").on("change", function () {

			var countryId = $(this).val();

			console.log("Country ID:", countryId);


			// تفريغ النباتات
			$("#ItemListId").empty();

			// إضافة الاختيار الافتراضي
			$("#ItemListId").append(
				new Option("-- اختار --", "", true, true)
			);

			$("#ItemListId").trigger("change");


			// تفريغ الاشتراطات القديمة
			$("#divdata").empty();


			if (!countryId || countryId == "0") {
				return;
			}


			// تعطيل النباتات أثناء التحميل
			$("#ItemListId").prop("disabled", true);


			// =================================================
			// جلب النباتات
			// =================================================

			$.ajax({

				url: "/ExportingProcedure/GetItemsByCountry",

				type: "GET",

				data: {
					CountryID: countryId
				},

				success: function (data) {

					console.log("Items:", data);


					$.each(data, function (index, item) {

						$("#ItemListId").append(
							new Option(
								item.name_Ar,
								item.id,
								false,
								false
							)
						);

					});


					$("#ItemListId")
						.prop("disabled", false)
						.trigger("change");

				},

				error: function (xhr, status, error) {

					console.log("GetItems Error:", error);

					console.log(
						"Response:",
						xhr.responseText
					);

					$("#ItemListId")
						.prop("disabled", false);

					alert("حدث خطأ أثناء تحميل النباتات");

				}

			});

		});


		// =====================================================
		// تغيير النبات
		// =====================================================

		$("#ItemListId").on("change", function () {

			$("#divdata").empty();

		});


		// =====================================================
		// زر البحث
		// =====================================================

		$("#searchForm").on("submit", function (e) {

			// منع Reload الصفحة
			e.preventDefault();


			var countryId = $("#ImInitiatorListId").val();
			var itemId = $("#ItemListId").val();


			console.log("Search CountryID:", countryId);
			console.log("Search ItemID:", itemId);


			// =================================================
			// التأكد من اختيار الدولة
			// =================================================

			if (!countryId || countryId == "0") {

				alert("من فضلك اختر الدولة");

				return;
			}


			// =================================================
			// التأكد من اختيار النبات
			// =================================================

			if (!itemId || itemId == "0") {

				alert("من فضلك اختر النبات");

				return;
			}


			// =================================================
			// إظهار Loading
			// =================================================

			$("#divdata").html(
				'<div class="text-center p-4">' +
				'<span>جاري تحميل الاشتراطات...</span>' +
				'</div>'
			);


			// تعطيل زر البحث
			$("#btnsearch").prop("disabled", true);


			// =================================================
			// جلب الاشتراطات
			// =================================================

			$.ajax({

				url: "/ExportingProcedure/GetConstraints",

				type: "GET",

				data: {
					CountryID: countryId,
					ItemID: itemId
				},

				success: function (data) {

					console.log("Constraints:", data);


					// عرض الـ Partial داخل divdata
					$("#divdata").html(data);

				},

				error: function (xhr, status, error) {

					console.log("GetConstraints Error:", error);

					console.log(
						"Response:",
						xhr.responseText
					);


					$("#divdata").html(
						'<div class="alert alert-danger">' +
						'حدث خطأ أثناء تحميل الاشتراطات' +
						'</div>'
					);

				},

				complete: function () {

					// إعادة تفعيل زر البحث
					$("#btnsearch").prop("disabled", false);

				}

			});

		});

	});

</script>

