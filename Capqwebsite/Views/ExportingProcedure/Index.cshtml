@model List<ViewModels.ExportingProcedureVM>

@{
    var langCookies = Context.Request.Cookies.FirstOrDefault(c => c.Key == "Lang").Value;
    var lang = string.IsNullOrEmpty(langCookies) ? "ar" : langCookies;
}

<link rel="stylesheet" href="~/css/procedure-search.css" asp-append-version="true" />
<div class="procedure-page" dir="rtl">
    <header class="procedure-heading">
        <div class="procedure-container">
            <nav class="procedure-breadcrumb" aria-label="مسار الصفحة"><a href="@Url.Action("Index", "Home")">الرئيسية</a><span>›</span> اشتراطات التصدير</nav>
            <div class="procedure-title"><div><span>التصدير</span><h1>اشتراطات التصدير</h1></div><div class="procedure-title-icon"><i class="fas fa-balance-scale" aria-hidden="true"></i></div></div>
        </div>
    </header>
    <div class="procedure-content procedure-container">
        <section class="procedure-panel" aria-labelledby="procedure-search-title">
            <div class="procedure-panel-head"><div><h2 id="procedure-search-title">البحث في اشتراطات التصدير</h2><p>اختر دولة التصدير والنبات للوصول إلى الاشتراطات والبيانات المرتبطة بهما.</p></div><span class="procedure-badge">استعلام إلكتروني</span></div>
            <div class="procedure-search-area">
                <form id="searchForm">
                    <div class="procedure-form-grid">
                        <div class="procedure-field"><label for="ImInitiatorListId">دولة التصدير</label>
                            @Html.DropDownList("CountryID", (IEnumerable<SelectListItem>)ViewData["CountryList"], "-- اختر دولة التصدير --", new { id = "ImInitiatorListId", @class = "form-control" })
                        </div>
                        <div class="procedure-field"><label for="ItemListId">النبات</label>
                            @Html.DropDownList("ItemID", (IEnumerable<SelectListItem>)ViewData["ItemList"], "-- اختر النبات --", new { id = "ItemListId", @class = "form-control" })
                        </div>
                        <button id="btnsearch" class="procedure-search-btn" type="submit">بحث</button>
                    </div>
                </form>
                <div class="procedure-helper"><i class="fas fa-info-circle" aria-hidden="true"></i><span>يرجى تحديد دولة التصدير والنبات ثم الضغط على «بحث» لعرض اشتراطات التصدير المتاحة.</span></div>
                <div id="divdata" class="procedure-results" aria-live="polite">
                    @if (Model != null && Model.Any())
                    {
                        <partial name="_PartialExporting.cshtml" model="Model" />
                    }
                </div>
            </div>
        </section>
    </div>
</div>
<div class="modal fade"
     id="certificateModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <!-- Header -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="certificateModalTitle">
                    الشهادة
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Body -->

            <div class="modal-body">

                <div id="certificateModalContent"
                     class="certificate-modal-content">
                </div>

            </div>


            <!-- Footer -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    إغلاق

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- CSS -->
<!-- ===================================================== -->

<style>

    /* =========================================
           Certificate Column
           ========================================= */

    .certificate-cell {
        width: 300px;
        max-width: 300px;
        vertical-align: top;
        word-break: break-word;
    }


    /* =========================================
           Certificate Preview
           يظهر جزء فقط من النص
           ========================================= */

    .certificate-preview {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        line-height: 1.8;
        max-height: 5.4em;
        word-break: break-word;
    }


    /* =========================================
           Show More Button
           ========================================= */

    .show-certificate {
        padding: 0;
        margin-top: 5px;
        text-decoration: underline;
        color: #0d6efd;
        cursor: pointer;
        font-size: 13px;
    }


        .show-certificate:hover {
            text-decoration: none;
            color: #084298;
        }


    /* =========================================
           Modal Content
           ========================================= */

    .certificate-modal-content {
        max-height: 60vh;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-word;
        line-height: 2;
        font-size: 16px;
        padding: 10px;
    }

</style>


<!-- ===================================================== -->
<!-- jQuery -->
<!-- ===================================================== -->

<script src="~/js/jquery-3.4.1.min.js"></script>


<!-- ===================================================== -->
<!-- JavaScript -->
<!-- ===================================================== -->

<script>

    $(document).ready(function () {


        // =====================================================
        // Select2
        // =====================================================

        $("#ItemListId").select2({

            placeholder: "-- اختار --",

            allowClear: true,

            width: "100%"

        });


        $("#ImInitiatorListId").select2({

            placeholder: "-- اختار --",

            allowClear: true,

            width: "100%"

        });


        // =====================================================
        // تغيير الدولة
        // =====================================================

        $("#ImInitiatorListId").on("change", function () {

            var countryId = $(this).val();

            console.log("Country ID:", countryId);


            // تفريغ النباتات

            $("#ItemListId").empty();


            // الاختيار الافتراضي

            $("#ItemListId").append(

                new Option(
                    "-- اختار --",
                    "",
                    true,
                    true
                )

            );


            $("#ItemListId").trigger("change");


            // تفريغ النتائج القديمة

            $("#divdata").empty();


            // التأكد من اختيار الدولة

            if (!countryId || countryId == "0") {

                return;

            }


            // تعطيل النباتات أثناء التحميل

            $("#ItemListId").prop("disabled", true);


            // =================================================
            // جلب النباتات
            // =================================================

            $.ajax({

                url: "/ExportingProcedure/GetItemsByCountry",

                type: "GET",

                data: {

                    CountryID: countryId

                },


                success: function (data) {

                    console.log("Items:", data);


                    $.each(data, function (index, item) {

                        $("#ItemListId").append(

                            new Option(

                                item.name_Ar,

                                item.id,

                                false,

                                false

                            )

                        );

                    });


                    $("#ItemListId")

                        .prop("disabled", false)

                        .trigger("change");

                },


                error: function (xhr, status, error) {

                    console.log(
                        "GetItems Error:",
                        error
                    );


                    console.log(
                        "Response:",
                        xhr.responseText
                    );


                    $("#ItemListId")
                        .prop("disabled", false);


                    alert(
                        "حدث خطأ أثناء تحميل النباتات"
                    );

                }

            });

        });


        // =====================================================
        // تغيير النبات
        // =====================================================

        $("#ItemListId").on("change", function () {

            $("#divdata").empty();

        });


        // =====================================================
        // زر البحث
        // =====================================================

        $("#searchForm").on("submit", function (e) {

            // منع Reload الصفحة

            e.preventDefault();


            var countryId =
                $("#ImInitiatorListId").val();


            var itemId =
                $("#ItemListId").val();


            console.log(
                "Search CountryID:",
                countryId
            );


            console.log(
                "Search ItemID:",
                itemId
            );


            // =================================================
            // التأكد من الدولة
            // =================================================

            if (!countryId || countryId == "0") {

                alert(
                    "من فضلك اختر الدولة"
                );

                return;

            }


            // =================================================
            // التأكد من النبات
            // =================================================

            if (!itemId || itemId == "0") {

                alert(
                    "من فضلك اختر النبات"
                );

                return;

            }


            // =================================================
            // Loading
            // =================================================

            $("#divdata").html(

                '<div class="text-center p-4">' +

                '<span>جاري تحميل الاشتراطات...</span>' +

                '</div>'

            );


            // تعطيل البحث

            $("#btnsearch")
                .prop("disabled", true);


            // =================================================
            // جلب الاشتراطات
            // =================================================

            $.ajax({

                url:
                    "/ExportingProcedure/GetConstraints",

                type: "GET",

                data: {

                    CountryID: countryId,

                    ItemID: itemId

                },


                success: function (data) {

                    console.log(
                        "Constraints:",
                        data
                    );


                    // تحميل الـ Partial

                    $("#divdata").html(data);

                },


                error: function (
                    xhr,
                    status,
                    error
                ) {

                    console.log(
                        "GetConstraints Error:",
                        error
                    );


                    console.log(
                        "Response:",
                        xhr.responseText
                    );


                    $("#divdata").html(

                        '<div class="alert alert-danger">' +

                        'حدث خطأ أثناء تحميل الاشتراطات' +

                        '</div>'

                    );

                },


                complete: function () {

                    // إعادة تفعيل البحث

                    $("#btnsearch")
                        .prop("disabled", false);

                }

            });

        });


        // =====================================================
        // Certificate Popup
        //
        // مهم:
        // نستخدم document.on لأن الجدول يتم تحميله AJAX
        // =====================================================

        $(document)
            .off("click", ".show-certificate")
            .on(
                "click",
                ".show-certificate",
                function () {

                    var title =
                        $(this).attr(
                            "data-title"
                        );


                    var content =
                        $(this).attr(
                            "data-content"
                        );


                    // عنوان Popup

                    $("#certificateModalTitle")
                        .text(title);


                    // النص الكامل

                    $("#certificateModalContent")
                        .text(content);


                    // فتح Bootstrap 5 Modal

                    var modalElement =
                        document.getElementById(
                            "certificateModal"
                        );


                    var modal =
                        bootstrap.Modal
                            .getOrCreateInstance(
                                modalElement
                            );


                    modal.show();

                }
            );


    });

</script>
