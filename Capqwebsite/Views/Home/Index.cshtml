@* ===== ABOUT ===== *@
<section id="about" class="py-24 beigecolor">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 md:grid-cols-2 md:items-start">
        <div>
            <div class="ornament-divider mb-6 max-w-xs me-auto ms-0">
                <span class="font-display text-sm uppercase tracking-[0.3em]">عن الإدارة</span>
            </div>
            <h2 class="font-display text-4xl font-bold leading-tight text-primary-deep md:text-5xl">
                الحجر الزراعي المصري<br /><span class="text-gold">يرحب بكم</span>
            </h2>
            <div class="mt-8 space-y-5 leading-loose text-foreground/85">
                @if (Model.Intro != null && Model.Intro.Any())
                {
                    @foreach (var item in Model.Intro)
                    {
                        <div class="capq-about__text">
                            <p>@item.descAr</p>
                        </div>
                    }
                }
                else
                {
                    <div class="capq-about__text">
                        <p>يُعد الحجر الزراعي المصري أحد الركائز الأساسية للسياسة الزراعية في مصر، وقد ارتبطت نشأته بتطور التجارة الزراعية الدولية وازدياد مخاطر انتقال الآفات والأمراض النباتية عبر الحدود.</p>
                        <p>يسهم الحجر الزراعي في دعم الصادرات الزراعية المصرية بتطبيق المعايير الدولية للصحة النباتية وفقاً لاتفاقية الوقاية الدولية للنبات (IPPC).</p>
                    </div>
                }
            </div>
            <div class="mt-2 grid gap-4 sm:grid-cols-2">
                <div class="rounded-xl border border-border bg-card p-3">
                    <div class="mb-3 inline-grid size-10 place-items-center rounded-md bg-primary-deep text-gold">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-shield-check size-5"
                             aria-hidden="true">
                            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                    </div>
                    <div class="font-display text-base font-bold text-primary-deep">حماية الثروة النباتية</div>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                        منع دخول وانتشار الآفات الحجرية عبر المنافذ.
                    </p>
                </div>
                <div class="rounded-xl border border-border bg-card p-3">
                    <div class="mb-3 inline-grid size-10 place-items-center rounded-md bg-primary-deep text-gold">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-globe size-5"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                            <path d="M2 12h20"></path>
                        </svg>
                    </div>
                    <div class="font-display text-base font-bold text-primary-deep">تمثيل دولي</div>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                        عضو في الاتفاقية الدولية لوقاية النباتات (IPPC).
                    </p>
                </div>
            </div>
        </div>
        <div class="relative">
            <div class="absolute -inset-4 -z-10 rounded-2xl"></div>
            <img src="/img/inspection.jpg"
                 alt="فحص النباتات في المعمل"
                 width="1280"
                 height="1280"
                 loading="lazy"
                 class="aspect-[4/5] w-full rounded-xl object-cover shadow-elegant imgs" />
            <div class="absolute bottom-6 start-6 max-w-[18rem] rounded-lg bg-background/95 p-3 shadow-elegant backdrop-blur">
                <div class="font-display text-2xl font-bold text-primary-deep">القانون 53 لسنة 1966</div>
                <div class="mt-1 text-xs text-muted-foreground">
                    الإطار التشريعي الرئيسي المنظم لأعمال الحجر الزراعي في مصر
                </div>
            </div>
        </div>
    </div>
</section>





@* ===== NEWS ===== *@

<section id="news" class="bg-gold-soft py-24">
    <div class="mx-auto max-w-7xl px-6">
        <div class="mb-12 flex items-end justify-between gap-6">
            <div>
                <div class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-primary">المركز الإعلامي</div>
                <h2 class="font-display text-4xl font-bold text-primary-deep md:text-5xl">آخر الأخبار</h2>
            </div>
            <a href="@Url.Action("Index", "News", new { ID = 7 })"
               class="hidden md:inline-flex items-center gap-2 text-sm font-semibold text-primary-deep hover:text-gold">
                مشاهدة المزيد
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-arrow-left size-4"
                     aria-hidden="true">
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                </svg>
            </a>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
            @if (Model.News != null)
            {
                @foreach (var item in Model.News)
                {
            <article class="group flex flex-col overflow-hidden rounded-xl border border-primary-deep/10 bg-background transition-all hover:border-gold hover:shadow-elegant">
                <div class="relative aspect-[16/10] overflow-hidden">
                            <img src="@item.filepath" alt="@item.TitleAr"
                         loading="lazy"
                         class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-primary-deep/40 to-transparent"></div>
                    <div class="absolute bottom-3 start-3 inline-flex items-center gap-2 rounded-full bg-background/90 px-3 py-1 text-[11px] font-semibold text-primary-deep">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-newspaper size-3"
                             aria-hidden="true">
                            <path d="M15 18h-5"></path>
                            <path d="M18 14h-8"></path>
                            <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"></path>
                            <rect width="8" height="4" x="10" y="6" rx="1"></rect>
                        </svg>
                        خبر
                    </div>
                </div>
                <div class="flex flex-1 flex-col p-6">
                    <h3 class="font-display text-lg font-bold leading-snug text-primary-deep">
                                @item.TitleAr
                            </h3>
                    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
                                @item.descAr
                            </p>
                            <a href="@Url.Action("RowDetail", "News", new { ID = item.ID, Type = "الأخبار" })"
                       class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-gold hover:text-primary-deep">
                        تفاصيل
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-arrow-left size-4"
                             aria-hidden="true">
                            <path d="m12 19-7-7 7-7"></path>
                            <path d="M19 12H5"></path>
                        </svg>
                    </a>
                </div>
            </article>
         
                }
            }
        </div>
    </div>
</section>

