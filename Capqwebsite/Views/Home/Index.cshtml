                       <a href="@Url.Action("Index", "ExportingProcedure")"
                                                                                                                                                                                                                                                     class="inline-flex items-center gap-2 rounded-md border border-primary-foreground/30 bg-primary-foreground/5 px-6 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary-foreground/15">اشتراطات التصدير</a>
