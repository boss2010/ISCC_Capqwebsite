@model ViewModels.HomeVM
@{
    ViewData["Title"] = "Home Page";
    var heroImg = "url('/img/hero-fields.jpg')";
}

@* ===== TOP BAR ===== *@
<div class="capq-topbar">
    <div class="container">
        <span>جمهورية مصر العربية — وزارة الزراعة واستصلاح الأراضي</span>
        <div class="capq-topbar__links">
            <a href="@Url.Action("Index","contact")">اتصل بنا</a>
            <span>|</span>
            <a href="#">English</a>
        </div>
    </div>
</div>

@* ===== HERO ===== *@
<section class="capq-hero" style="background-image:linear-gradient(to left,rgba(18,46,30,.95),rgba(18,46,30,.85),rgba(18,46,30,.5)),url('/img/hero-fields.jpg');background-size:cover;background-position:center">
    <div class="container">
        <div class="capq-hero__badge">
            <span class="capq-hero__badge-dot"></span>
            بوابة حكومية رسمية
        </div>
        <h1 class="capq-hero__h1">
            خدمات الحجر الزراعي
            <span class="capq-hero__h1-gold">في واجهة رقمية موحدة</span>
        </h1>
        <p class="capq-hero__lead">معلومات موثقة، خدمات إلكترونية، تشريعات، تنبيهات وإحصائيات في تجربة أسرع وأكثر وضوحاً للمستوردين والمصدرين والجهات الحكومية.</p>
        <div class="capq-hero__actions">
            <a href="https://www.capq.gov.eg/Exporting/Main" class="capq-btn capq-btn--gold" target="_blank">
                الخدمات الإلكترونية
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="@Url.Action("Index","ImportingProcedure")" class="capq-btn capq-btn--ghost">اشتراطات الاستيراد</a>
            <a href="@Url.Action("Index","ExportingProcedure")" class="capq-btn capq-btn--ghost">اشتراطات التصدير</a>
        </div>
        <div class="capq-hero__trust">
            <span>• تشريعات محدّثة</span>
            <span>• مؤشرات مباشرة</span>
            <span>• تنبيهات رسمية</span>
        </div>
    </div>
</section>

@* ===== QUICK LINKS ===== *@
<section class="capq-quicklinks">
    <div class="container">
        <div class="capq-quicklinks__grid">
            <a href="@Url.Action("Index","AgricultureLaw",new{ID=1})" class="capq-quicklink">
                <div class="capq-quicklink__icon"><i class="fas fa-file-alt"></i></div>
                <div>
                    <div class="capq-quicklink__title">التشريعات</div>
                    <div class="capq-quicklink__sub">قوانين وقرارات الحجر الزراعي</div>
                </div>
            </a>
            <a href="@Url.Action("Index","Offices")" class="capq-quicklink">
                <div class="capq-quicklink__icon"><i class="fas fa-building"></i></div>
                <div>
                    <div class="capq-quicklink__title">مكاتبنا</div>
                    <div class="capq-quicklink__sub">فروع ومنافذ الإدارة</div>
                </div>
            </a>
            <a href="@Url.Action("Index","News",new{ID=8})" class="capq-quicklink">
                <div class="capq-quicklink__icon"><i class="fas fa-bullhorn"></i></div>
                <div>
                    <div class="capq-quicklink__title">الإعلانات</div>
                    <div class="capq-quicklink__sub">آخر إعلانات الإدارة</div>
                </div>
            </a>
            <a href="@Url.Action("dash","dashBoard")" class="capq-quicklink">
                <div class="capq-quicklink__icon"><i class="fas fa-chart-column"></i></div>
                <div>
                    <div class="capq-quicklink__title">الإحصائيات</div>
                    <div class="capq-quicklink__sub">لوحة المؤشرات والبيانات</div>
                </div>
            </a>
        </div>
    </div>
</section>

@* ===== ABOUT ===== *@
<section class="capq-about">
    <div class="container">
        <div class="capq-about__grid">
            <div class="capq-about__content">
                <div class="capq-ornament">عن الإدارة</div>
                <h2 class="capq-about__h2">الحجر الزراعي المصري<br><span class="capq-gold">يرحب بكم</span></h2>
                @if (Model.Intro != null && Model.Intro.Any())
                {
                    @foreach (var item in Model.Intro)
                    {
                        <div class="capq-about__text">
                            <p>@item.descAr</p>
                        </div>
                    }
                }
                else
                {
                    <div class="capq-about__text">
                        <p>يُعد الحجر الزراعي المصري أحد الركائز الأساسية للسياسة الزراعية في مصر، وقد ارتبطت نشأته بتطور التجارة الزراعية الدولية وازدياد مخاطر انتقال الآفات والأمراض النباتية عبر الحدود.</p>
                        <p>يسهم الحجر الزراعي في دعم الصادرات الزراعية المصرية بتطبيق المعايير الدولية للصحة النباتية وفقاً لاتفاقية الوقاية الدولية للنبات (IPPC).</p>
                    </div>
                }
                <div class="capq-about__cards">
                    <div class="capq-about__card">
                        <div class="capq-about__card-icon"><i class="fas fa-shield-check"></i></div>
                        <div class="capq-about__card-title">حماية الثروة النباتية</div>
                        <p>منع دخول وانتشار الآفات الحجرية عبر المنافذ.</p>
                    </div>
                    <div class="capq-about__card">
                        <div class="capq-about__card-icon"><i class="fas fa-globe"></i></div>
                        <div class="capq-about__card-title">تمثيل دولي</div>
                        <p>عضو في الاتفاقية الدولية لوقاية النباتات (IPPC).</p>
                    </div>
                </div>
            </div>
            <div class="capq-about__visual">
                <div class="capq-about__img-wrap">
                    @if (Model.Intro != null && Model.Intro.Any())
                    {
                        <img src="@Model.Intro.First().filepath" alt="فحص النباتات" class="capq-about__img" />
                    }
                    else
                    {
                        <img src="~/img/logo-capq.png" alt="الحجر الزراعي" class="capq-about__img" style="object-fit:contain;padding:2rem" />
                    }
                    <div class="capq-about__badge">
                        <div class="capq-about__badge-title">القانون 356 لسنة 1954</div>
                        <div class="capq-about__badge-sub">الإطار التشريعي الرئيسي المنظم لأعمال الحجر الزراعي في مصر</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== NEWS ===== *@
<section class="capq-news" id="news">
    <div class="container">
        <div class="capq-sec-head">
            <div>
                <div class="capq-sec-eyebrow">المركز الإعلامي</div>
                <h2 class="capq-sec-h2">آخر الأخبار</h2>
            </div>
            <a href="@Url.Action("Index","News",new{ID=7})" class="capq-more-link">
                مشاهدة المزيد <i class="fas fa-arrow-left"></i>
            </a>
        </div>
        <div class="capq-news__grid">
            @if (Model.News != null)
            {
                @foreach (var item in Model.News)
                {
                    <article class="capq-news__card">
                        <div class="capq-news__img-wrap">
                            <img src="@item.filepath" alt="@item.TitleAr" class="capq-news__img" loading="lazy">
                            <div class="capq-news__type-badge"><i class="fas fa-newspaper"></i> خبر</div>
                        </div>
                        <div class="capq-news__body">
                            <h3 class="capq-news__title">@item.TitleAr</h3>
                            <p class="capq-news__desc">@item.descAr</p>
                            <a href="@Url.Action("RowDetail","News",new{ID=item.ID,Type="الأخبار"})" class="capq-news__link">
                                تفاصيل <i class="fas fa-arrow-left"></i>
                            </a>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</section>

@* ===== ANNOUNCEMENTS ===== *@
<section class="capq-ads" id="announcements">
    <div class="container">
        <div class="capq-sec-head">
            <div>
                <div class="capq-sec-eyebrow capq-sec-eyebrow--gold">رسائل رسمية</div>
                <h2 class="capq-sec-h2">الإعلانات</h2>
            </div>
            <a href="@Url.Action("Index","News",new{ID=8})" class="capq-more-link">
                مشاهدة المزيد <i class="fas fa-arrow-left"></i>
            </a>
        </div>
        <div class="capq-ads__grid">
            @if (Model.Advertis != null)
            {
                @foreach (var item in Model.Advertis)
                {
                    <a href="@Url.Action("RowDetail","News",new{ID=item.ID,Type="الإعلانات"})" class="capq-ad__item">
                        <div class="capq-ad__icon"><i class="fas fa-bullhorn"></i></div>
                        <div class="capq-ad__body">
                            <div class="capq-ad__type">إعلان</div>
                            <div class="capq-ad__title">@item.TitleAr</div>
                            <div class="capq-ad__arrow">التفاصيل <i class="fas fa-arrow-left"></i></div>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>

@* ===== ALERTS ===== *@
<section class="capq-alerts">
    <div class="container">
        <div class="capq-alerts__head">
            <div class="capq-sec-eyebrow capq-sec-eyebrow--gold">رسائل مهمة</div>
            <h2 class="capq-sec-h2 capq-sec-h2--white">التنبيهات</h2>
        </div>
        <div class="capq-alerts__grid">
            @if (Model.Alert != null)
            {
                @foreach (var item in Model.Alert)
                {
                    <article class="capq-alert__card">
                        <div class="capq-alert__top">
                            <div class="capq-alert__icon"><i class="fas fa-bell"></i></div>
                            @if (item.Date != null)
                            {
                                <div class="capq-alert__date"><i class="fas fa-calendar"></i> @item.Date.Value.ToString("dd-MM-yyyy")</div>
                            }
                        </div>
                        <h3 class="capq-alert__title">@item.TitleAr</h3>
                        <p class="capq-alert__desc">@item.descAr</p>
                    </article>
                }
            }
        </div>
    </div>
</section>

@* ===== CONTACT ===== *@
<section class="capq-contact" id="contact">
    <div class="container">
        <div class="capq-contact__grid">
            <div class="capq-contact__intro">
                <div class="capq-sec-eyebrow capq-sec-eyebrow--gold">تواصل معنا</div>
                <h2 class="capq-sec-h2">نحن في خدمتكم<span class="capq-gold capq-block">على مدار أيام العمل</span></h2>
                <p class="capq-contact__desc">للاستفسارات الفنية أو طلبات المعاينة وإصدار الشهادات يمكنكم التواصل مع الإدارة عبر القنوات الرسمية.</p>
            </div>
            <div class="capq-contact__items">
                <div class="capq-contact__item">
                    <div class="capq-contact__item-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div>
                        <div class="capq-contact__item-label">العنوان</div>
                        <div class="capq-contact__item-val">٦ شارع د/ ميشيل باخوم — الدقي — الجيزة، جمهورية مصر العربية</div>
                    </div>
                </div>
                <div class="capq-contact__item">
                    <div class="capq-contact__item-icon"><i class="fas fa-phone-alt"></i></div>
                    <div>
                        <div class="capq-contact__item-label">الهاتف</div>
                        <div class="capq-contact__item-val">(202) 37608574 — 3335162</div>
                    </div>
                </div>
                <div class="capq-contact__item">
                    <div class="capq-contact__item-icon"><i class="fas fa-envelope"></i></div>
                    <div>
                        <div class="capq-contact__item-label">البريد الإلكتروني</div>
                        <div class="capq-contact__item-val">ippc@capq.gov.eg — tech.office@capq.gov.eg</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
