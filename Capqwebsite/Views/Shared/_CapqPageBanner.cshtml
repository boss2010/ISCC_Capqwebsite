@model string
<link rel="stylesheet" href="~/css/capq-page-banner.css"  />
<header class="capq-page-banner" dir="rtl">
    <div class="capq-page-banner__art" aria-hidden="true"></div>
    <div class="capq-page-banner__identity">
        <img class="capq-page-banner__logo" src="~/img/logo-capq2.png" alt="شعار الحجر الزراعي المصري" />
        <div class="capq-page-banner__text">
            <p class="capq-page-banner__name">الإدارة المركزية للحجر الزراعي</p>
            <p class="capq-page-banner__english" lang="en" dir="ltr">Central Administration of Plant Quarantine</p>
            <p class="capq-page-banner__slogan">من أجل زراعة آمنة .. لمستقبل أفضل</p>
            <h1 class="capq-page-banner__title">@Model</h1>
        </div>
    </div>
</header>