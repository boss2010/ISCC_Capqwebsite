@model List<ViewModels.ListNewsVM>

<!-- Page Header -->
<div class="gov-page-header">
    <div class="container">
        <div class="gov-page-header__inner">
            <div class="gov-page-header__title">
                <span class="gov-page-header__icon"><i class="fas fa-newspaper"></i></span>
                <div>
                    <span class="gov-page-header__eyebrow">المركز الإعلامي</span>
                    <h1 class="gov-page-header__h1">@ViewBag.TypeAr</h1>
                </div>
            </div>
            <nav class="gov-breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="gov-breadcrumb__link">الرئيسية</a>
                <i class="fas fa-chevron-left gov-breadcrumb__sep"></i>
                <span class="gov-breadcrumb__current">@ViewBag.TypeAr</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid gov-inner-page">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="gov-news-card card">
                            <img class="card-img-top img-height" src="@item.filepath" alt="@item.TitleAr">
                            <div class="card-body p-4">
                                <h5 class="mb-3">@item.TitleAr</h5>
                                <p class="mb-3">@item.descAr</p>
                                <div class="d-flex gap-2 justify-content-between align-items-center">
                                    <a href="@Url.Action("RowDetail", "News", new { ID = item.ID, Type = ViewBag.TypeAr })" class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye ml-1"></i> التفاصيل
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.linkURL))
                                    {
                                        <a href="@item.linkURL" target="_blank" class="btn btn-secondary btn-sm">
                                            <i class="fas fa-external-link-alt ml-1"></i> المصدر
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="gov-empty-state">
                <i class="fas fa-newspaper gov-empty-state__icon"></i>
                <h3>لا توجد بيانات متاحة حالياً</h3>
                <p>لم يتم إضافة أي محتوى لهذا القسم بعد.</p>
            </div>
        }
    </div>
</div>
