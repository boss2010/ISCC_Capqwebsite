@model EF.Models.WebsiteTypeDetail

<!-- Page Header -->
<div class="gov-page-header">
    <div class="container">
        <div class="gov-page-header__inner">
            <div class="gov-page-header__title">
                <span class="gov-page-header__icon"><i class="fas fa-edit"></i></span>
                <div>
                    <span class="gov-page-header__eyebrow">لوحة التحكم</span>
                    <h1 class="gov-page-header__h1">تعديل @(ViewBag.TypeAr ?? "البيانات")</h1>
                </div>
            </div>
            <a class="btn btn-secondary" href="@Url.Action("Index", new { ID = Model.WebsitetypeID })">
                <i class="fas fa-arrow-right ml-1"></i> رجوع
            </a>
        </div>
    </div>
</div>

<div class="container-fluid gov-inner-page">
    <div class="container">
        <div class="gov-form-card">
            <div class="gov-form-card__header">
                <span class="gov-form-card__icon"><i class="fas fa-pen"></i></span>
                <h2 class="gov-form-card__title">تعديل بيانات @(ViewBag.TypeAr ?? "")</h2>
            </div>
            <div class="gov-form-card__body">
                <form asp-controller="DataEntry" asp-action="Update" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="ID" />
                    <input type="hidden" value="@ViewBag.IdType" name="IdType" />
                    <input type="hidden" value="@ViewBag.EditMode" name="EditMode" />
                    <input type="hidden" asp-for="WebsitetypeID" />
                    <input type="hidden" asp-for="filepath" />

                    @if (ViewBag.ID != 9)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.TitleAr</label>
                            <input asp-for="TitleAr" type="text" class="form-control" placeholder="@ViewBag.TitleAr">
                            <span asp-validation-for="TitleAr" class="text-danger"></span>
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 12 || ViewBag.ID == 17)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.TitleEn</label>
                            <input asp-for="TitleEn" type="text" class="form-control" placeholder="@ViewBag.TitleEn">
                            <span asp-validation-for="TitleEn" class="text-danger"></span>
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10 || ViewBag.ID == 11 || ViewBag.ID == 12)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.descAr</label>
                            <textarea asp-for="descAr" rows="4" class="form-control"></textarea>
                            <span asp-validation-for="descAr" class="text-danger"></span>
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 12 || ViewBag.ID == 17)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.descEn</label>
                            <textarea asp-for="descEn" rows="4" class="form-control"></textarea>
                            <span asp-validation-for="descEn" class="text-danger"></span>
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.Date</label>
                            <input asp-for="Date" type="date" class="form-control" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                    }
                    @if ((ViewBag.ID == 8) || (ViewBag.ID != 15 && ViewBag.ID != 16 && ViewBag.ID != 12 && ViewBag.ID != 10 && ViewBag.ID != 14 && ViewBag.ID != 6 && ViewBag.ID != 17))
                    {
                        @if (!string.IsNullOrEmpty(Model.filepath))
                        {
                            <div class="form-group">
                                <label class="gov-label">الملف الحالي</label>
                                <div class="gov-current-file">
                                    @if (Model.filepath.EndsWith(".pdf"))
                                    {
                                        <a href="#" class="gov-file-badge openPdf" data-pdf="@Model.filepath">
                                            <i class="fas fa-file-pdf ml-1"></i>@Model.TitleAr
                                        </a>
                                    }
                                    else if (Model.filepath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                             Model.filepath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                             Model.filepath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                                             Model.filepath.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) ||
                                             Model.filepath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) ||
                                             Model.filepath.EndsWith(".bmp", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <img src="@Model.filepath" alt="الصورة الحالية" class="gov-current-img" />
                                    }
                                </div>
                            </div>
                        }
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.filepath <small class="text-muted">(اتركه فارغاً للإبقاء على الحالي)</small></label>
                            <input name="imageFile" type="file" class="form-control">
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 15 || ViewBag.ID == 16 || ViewBag.ID == 12 || ViewBag.ID == 14 || ViewBag.ID == 6 || ViewBag.ID == 17)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.linkURL</label>
                            <input asp-for="linkURL" type="text" class="form-control" />
                            <span asp-validation-for="linkURL" class="text-danger"></span>
                        </div>
                    }

                    <div class="gov-form-actions">
                        <button class="mar-l-10  md:inline-flex  items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors services btn-pay" type="submit">
                            <i class="fas fa-save ml-1"></i> حفظ التعديلات
                        </button>
                        <a class="btn bg-secondary ml-2" href="@Url.Action("Index", new { ID = Model.WebsitetypeID })">
                            <i class="fas fa-times ml-1"></i> إلغاء
                        </a>
                      
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- PDF Modal -->
<div id="pdfModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
    <div id="closeModal" style="position:absolute; top:16px; left:20px; cursor:pointer; color:#fff; font-size:18px; width:40px; height:40px; background:var(--gov-danger,#b42318); border-radius:50%; display:flex; align-items:center; justify-content:center;">
        <i class="fas fa-times"></i>
    </div>
    <iframe id="pdfFrame" style="width:min(92vw,1100px); height:min(80vh,760px); margin:6vh auto; display:block; border:none; border-radius:8px; background:#fff;"></iframe>
</div>

<script>
    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById("pdfFrame");
    const closeBtn = document.getElementById("closeModal");
    document.querySelectorAll(".openPdf").forEach(link => {
        link.addEventListener("click", function (e) {
            e.preventDefault();
            frame.src = this.getAttribute("data-pdf");
            modal.style.display = "flex";
        });
    });
    closeBtn.onclick = function () {
        modal.style.display = "none";
        frame.src = "";
    };
</script>
