@model List<EF.Models.WebsiteTypeDetail>

<!-- =========================
     Page Header
========================= -->
<div class="gov-page-header">
    <div class="container">
        <div class="gov-page-header__inner">
            <div class="gov-page-header__title">
                <span class="gov-page-header__icon">
                    <i class="fas fa-edit"></i>
                </span>

                <div>
                    <span class="gov-page-header__eyebrow">لوحة التحكم</span>
                    <h1 class="gov-page-header__h1">
                        إدارة @(ViewBag.TypeAr ?? "البيانات")
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="container-fluid gov-inner-page">
    <div class="container">

        <!-- =========================
             Warning Message
        ========================== -->
        @if (TempData["WarningMessage"] != null)
        {
            <div class="gov-alert gov-alert--warning mb-4">
                <i class="fas fa-exclamation-triangle ml-2"></i>
                @TempData["WarningMessage"]
            </div>
        }


        <!-- =========================
             Add Form Card
        ========================== -->
        <div class="gov-form-card mb-4">

            <div class="gov-form-card__header">
                <span class="gov-form-card__icon">
                    <i class="fas fa-plus-circle"></i>
                </span>

                <h2 class="gov-form-card__title">
                    إضافة @(ViewBag.TypeAr ?? "")
                </h2>
            </div>


            <div class="gov-form-card__body">

                <form asp-controller="DataEntry"
                      id="myForm"
                      asp-action="Index"
                      method="post"
                      enctype="multipart/form-data">

                    <input name="WebsitetypeID"
                           id="WebsitetypeID"
                           type="hidden"
                           value="@(ViewBag.ID ?? "0")" />

                    <div class="gov-form-fields">

                        @* =========================
           Title Arabic
        ========================== *@
                        @if (ViewBag.ID != 9)
                        {
                            <div class="gov-field">

                                <label class="gov-label">
                                    @ViewBag.TitleAr
                                </label>

                                <input name="TitleAr"
                                       type="text"
                                       class="form-control"
                                       placeholder="@ViewBag.TitleAr"
                                       autocomplete="off" />

                            </div>
                        }


                        @* =========================
           Title English
        ========================== *@
                        @if (ViewBag.ID == 12 || ViewBag.ID == 17)
                        {
                            <div class="gov-field">

                                <label class="gov-label">
                                    @ViewBag.TitleEn
                                </label>

                                <input name="TitleEn"
                                       type="text"
                                       class="form-control"
                                       placeholder="@ViewBag.TitleEn"
                                       autocomplete="off" />

                            </div>
                        }


                        @* =========================
           Date
        ========================== *@
                        @if (ViewBag.ID == 7 ||
                                                ViewBag.ID == 8 ||
                                                ViewBag.ID == 10)
                        {
                            <div class="gov-field">

                                <label class="gov-label">
                                    @ViewBag.Date
                                </label>

                                <input name="Date"
                                       type="date"
                                       class="form-control" />

                            </div>
                        }


                        @* =========================
           File
        ========================== *@
                        @if ((ViewBag.ID == 8) ||
                                                (ViewBag.ID != 15 &&
                                                ViewBag.ID != 16 &&
                                                ViewBag.ID != 12 &&
                                                ViewBag.ID != 14 &&
                                                ViewBag.ID != 6 &&
                                                ViewBag.ID != 10 &&
                                                ViewBag.ID != 17))
                        {
                            <div class="gov-field">

                                <label class="gov-label">
                                    @ViewBag.filepath
                                </label>

                                <input name="imageFile"
                                       type="file"
                                       class="form-control gov-file-input" />

                            </div>
                        }


                        @* =========================
           Link
        ========================== *@
                        @if (ViewBag.ID == 7 ||
                                                ViewBag.ID == 8 ||
                                                ViewBag.ID == 15 ||
                                                ViewBag.ID == 16 ||
                                                ViewBag.ID == 12 ||
                                                ViewBag.ID == 14 ||
                                                ViewBag.ID == 6 ||
                                                ViewBag.ID == 17)
                        {
                            <div class="gov-field">

                                <label class="gov-label">
                                    @ViewBag.linkURL
                                </label>

                                <input name="linkURL"
                                       type="text"
                                       class="form-control"
                                       placeholder="https://..."
                                       autocomplete="off" />

                            </div>
                        }


                        @* =========================
           Arabic Description
           Full Width
        ========================== *@
                        @if (ViewBag.ID == 7 ||
                                                ViewBag.ID == 8 ||
                                                ViewBag.ID == 10 ||
                                                ViewBag.ID == 11 ||
                                                ViewBag.ID == 12)
                        {
                            <div class="gov-field gov-field-full">

                                <label class="gov-label">
                                    @ViewBag.descAr
                                </label>

                                <textarea name="descAr"
                                      rows="4"
                                      class="form-control gov-textarea"
                                      autocomplete="off"
                                      placeholder="اكتب التفاصيل بالعربي..."></textarea>

                            </div>
                        }


                        @* =========================
           English Description
           Full Width
        ========================== *@
                        @if (ViewBag.ID == 12 || ViewBag.ID == 17)
                        {
                            <div class="gov-field gov-field-full">

                                <label class="gov-label">
                                    @ViewBag.descEn
                                </label>

                                <textarea name="descEn"
                                      rows="4"
                                      class="form-control gov-textarea gov-textarea-en"
                                      autocomplete="off"
                                      placeholder="Enter details in English..."></textarea>

                            </div>
                        }

                    </div>


                    @* =========================
       Save
    ========================== *@
                    <div class="gov-form-actions">

                        <button class="md:inline-flex
                       items-center
                       gap-2
                       rounded-md
                       bg-primary
                       px-4
                       py-2
                       text-sm
                       font-semibold
                       text-primary-foreground
                       transition-colors
                       services
                       btn-pay"
                                type="submit">

                            <i class="fas fa-save ml-1"></i>
                            حفظ

                        </button>

                    </div>

                </form>


            </div>
        </div>



        <!-- =========================
             Data Table Card
        ========================== -->
        <div class="gov-table-card">

            <div class="gov-table-card__body">

                <div class="table-responsive" id="div2">

                    <table class="table table-bordered table-striped table-hover">

                        <thead>

                            <tr>

                                <!-- Arabic Title -->
                                @if (ViewBag.ID != 9)
                                {
                                    <th>
                                        @ViewBag.TitleAr
                                    </th>
                                }


                                <!-- English Title -->
                                @if (ViewBag.ID == 12 || ViewBag.ID == 17)
                                {
                                    <th>
                                        @ViewBag.TitleEn
                                    </th>
                                }


                                <!-- Arabic Description -->
                                @if (ViewBag.ID == 7 ||
                                                                ViewBag.ID == 8 ||
                                                                ViewBag.ID == 10 ||
                                                                ViewBag.ID == 11 ||
                                                                ViewBag.ID == 12)
                                {
                                    <th class="description-column">
                                        @ViewBag.descAr
                                    </th>
                                }


                                <!-- English Description -->
                                @if (ViewBag.ID == 7 ||
                                                                ViewBag.ID == 12 ||
                                                                ViewBag.ID == 17)
                                {
                                    <th class="description-column">
                                        @ViewBag.descEn
                                    </th>
                                }


                                <!-- Date -->
                                @if (ViewBag.ID == 7 ||
                                                                ViewBag.ID == 8 ||
                                                                ViewBag.ID == 10)
                                {
                                    <th>
                                        @ViewBag.Date
                                    </th>
                                }


                                <!-- File -->
                                @if ((ViewBag.ID == 8) ||
                                                                (ViewBag.ID != 15 &&
                                                                ViewBag.ID != 16 &&
                                                                ViewBag.ID != 12 &&
                                                                ViewBag.ID != 14 &&
                                                                ViewBag.ID != 6 &&
                                                                ViewBag.ID != 10 &&
                                                                ViewBag.ID != 17))
                                {
                                    <th>
                                        الصورة / الملف
                                    </th>
                                }


                                <!-- Link -->
                                @if (ViewBag.ID == 7 ||
                                                                ViewBag.ID == 8 ||
                                                                ViewBag.ID == 15 ||
                                                                ViewBag.ID == 16 ||
                                                                ViewBag.ID == 12 ||
                                                                ViewBag.ID == 14 ||
                                                                ViewBag.ID == 6 ||
                                                                ViewBag.ID == 17)
                                {
                                    <th>
                                        @ViewBag.linkURL
                                    </th>
                                }


                                <th>
                                    الإجراءات
                                </th>

                                <th></th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model != null)
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <!-- =========================
                                             Arabic Title
                                        ========================== -->
                                        @if (ViewBag.ID != 9)
                                        {
                                            <td class="gov-title-cell">
                                                @if (!string.IsNullOrWhiteSpace(item.TitleAr))
                                                {
                                                    <span>
                                                        @item.TitleAr
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">
                                                        —
                                                    </span>
                                                }
                                            </td>
                                        }


                                        <!-- =========================
                                             English Title
                                        ========================== -->
                                        @if (ViewBag.ID == 12 || ViewBag.ID == 17)
                                        {
                                            <td class="gov-title-cell">

                                                @if (!string.IsNullOrWhiteSpace(item.TitleEn))
                                                {
                                                    <span>
                                                        @item.TitleEn
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>
                                        }


                                        <!-- =========================
                                             Arabic Description
                                        ========================== -->
                                        @if (ViewBag.ID == 7 ||
                                                                        ViewBag.ID == 8 ||
                                                                        ViewBag.ID == 10 ||
                                                                        ViewBag.ID == 11 ||
                                                                        ViewBag.ID == 12)
                                        {
                                            <td class="gov-description-cell">

                                                @if (!string.IsNullOrWhiteSpace(item.descAr))
                                                {
                                                    <div class="gov-description-preview">
                                                        @item.descAr
                                                    </div>

                                                    @if (item.descAr.Length > 150)
                                                    {
                                                        <button type="button"
                                                                class="gov-description-more openDetails"
                                                                data-title="التفاصيل بالعربي"
                                                                data-content="@item.descAr"
                                                                data-direction="rtl">

                                                            <i class="fas fa-expand-alt"></i>

                                                            عرض التفاصيل

                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>
                                        }


                                        <!-- =========================
                                             English Description
                                        ========================== -->
                                        @if (ViewBag.ID == 7 ||
                                                                        ViewBag.ID == 12 ||
                                                                        ViewBag.ID == 17)
                                        {
                                            <td class="gov-description-cell">

                                                @if (!string.IsNullOrWhiteSpace(item.descEn))
                                                {
                                                    <div class="gov-description-preview">
                                                        @item.descEn
                                                    </div>

                                                    @if (item.descEn.Length > 150)
                                                    {
                                                        <button type="button"
                                                                class="gov-description-more openDetails"
                                                                data-title="Details in English"
                                                                data-content="@item.descEn"
                                                                data-direction="ltr">

                                                            <i class="fas fa-expand-alt"></i>

                                                            View Details

                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>
                                        }


                                        <!-- =========================
                                             Date
                                        ========================== -->
                                        @if (ViewBag.ID == 7 ||
                                                                        ViewBag.ID == 8 ||
                                                                        ViewBag.ID == 10)
                                        {
                                            <td>

                                                @if (item.Date != null)
                                                {
                                                    @item.Date.Value.ToString("yyyy-MM-dd")
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>
                                        }


                                        <!-- =========================
                                             File
                                        ========================== -->
                                        @if ((ViewBag.ID == 8) ||
                                                                        (ViewBag.ID != 15 &&
                                                                        ViewBag.ID != 16 &&
                                                                        ViewBag.ID != 12 &&
                                                                        ViewBag.ID != 14 &&
                                                                        ViewBag.ID != 6 &&
                                                                        ViewBag.ID != 10 &&
                                                                        ViewBag.ID != 17))
                                        {
                                            <td>

                                                @if (!string.IsNullOrEmpty(item.filepath))
                                                {
                                                    if (item.filepath.EndsWith(".pdf",
                                                    StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <a href="#"
                                                           class="gov-file-badge openPdf"
                                                           data-pdf="@item.filepath">

                                                            <i class="fas fa-file-pdf ml-1"></i>

                                                            @(string.IsNullOrWhiteSpace(item.TitleAr)
                                                                                                    ? "فتح الملف"
                                                                                                    : item.TitleAr)

                                    </a>
                                                                        }
                                                    else if (
                                                    item.filepath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                                    item.filepath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                                    item.filepath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                                                    item.filepath.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) ||
                                                    item.filepath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) ||
                                                    item.filepath.EndsWith(".bmp", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <img src="@item.filepath"
                                                             alt="صورة"
                                                             class="gov-table-thumb" />
                                                    }
                                                    else
                                                    {
                                                        <a href="@item.filepath"
                                                           target="_blank"
                                                           class="gov-file-badge">

                                                            <i class="fas fa-file ml-1"></i>
                                                            فتح الملف

                                                        </a>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>
                                        }


                                        <!-- =========================
                                             Link
                                        ========================== -->
                                        @if (ViewBag.ID == 7 ||
                                                                        ViewBag.ID == 8 ||
                                                                        ViewBag.ID == 15 ||
                                                                        ViewBag.ID == 16 ||
                                                                        ViewBag.ID == 12 ||
                                                                        ViewBag.ID == 14 ||
                                                                        ViewBag.ID == 6 ||
                                                                        ViewBag.ID == 17)
                                        {
                                            <td>

                                                @if (!string.IsNullOrEmpty(item.linkURL))
                                                {
                                                    <a href="@item.linkURL"
                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       class="gov-link">

                                                        <i class="fas fa-external-link-alt ml-1"></i>

                                                        فتح الرابط

                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>
                                        }


                                        <!-- =========================
                                             Actions
                                        ========================== -->
                                        <td>

                                            <div class="gov-actions-cell">

                                                <a href="@Url.Action("Edit", new { id = item.ID, IdType = ViewBag.ID })"
                                                   class="btn btn-sm gov-btn-edit"
                                                   title="تعديل">

                                                    <i class="fas fa-edit"></i>

                                                </a>


                                                <a href="@Url.Action("Delete", "DataEntry", new { id = item.ID })"
                                                   class="btn btn-sm gov-btn-delete"
                                                   title="حذف"
                                                   onclick="return confirm('هل أنت متأكد من الحذف؟');">

                                                    <i class="fas fa-trash"></i>

                                                </a>

                                            </div>

                                        </td>


                                        <td></td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>



<!-- =====================================================
     PDF Modal
====================================================== -->
<div id="pdfModal"
     class="gov-pdf-modal">

    <div id="closeModal"
         class="gov-pdf-close"
         title="إغلاق">

        <i class="fas fa-times"></i>

    </div>

    <iframe id="pdfFrame"
            class="gov-pdf-frame">
    </iframe>

</div>



<!-- =====================================================
     Details Modal
====================================================== -->
<div id="detailsModal"
     class="gov-details-modal">

    <div class="gov-details-modal__content">

        <!-- Header -->
        <div class="gov-details-modal__header">

            <h3 id="detailsModalTitle"
                class="gov-details-modal__title">

                <i class="fas fa-align-right"></i>

                التفاصيل

            </h3>


            <button type="button"
                    id="closeDetailsModal"
                    class="gov-details-modal__close"
                    aria-label="إغلاق">

                <i class="fas fa-times"></i>

            </button>

        </div>


        <!-- Body -->
        <div id="detailsModalBody"
             class="gov-details-modal__body">

            <p id="detailsModalText"
               class="gov-details-modal__text">
            </p>

        </div>

    </div>

</div>



<!-- =====================================================
     CSS
====================================================== -->
<style>

    /* ========================================
           FORM
        ======================================== */

    .gov-form-card .form-group {
        margin-bottom: 20px;
    }


    .gov-label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 700;
        color: #344054;
    }


    .gov-form-card .form-control {
        width: 100%;
        min-height: 46px;
        padding: 10px 14px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        background-color: #fff;
        color: #101828;
        font-size: 14px;
        line-height: 1.6;
        transition: all .2s ease;
        box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
    }


    .gov-form-card textarea.form-control {
        min-height: 120px;
        resize: vertical;
        line-height: 1.9;
    }


    .gov-form-card textarea.gov-textarea {
        direction: rtl;
        text-align: right;
    }


    .gov-form-card textarea.gov-textarea-en {
        direction: ltr;
        text-align: left;
    }


    .gov-form-card .form-control:hover {
        border-color: #98a2b3;
    }


    .gov-form-card .form-control:focus {
        border-color: #1570ef;
        outline: none;
        box-shadow: 0 0 0 4px rgba(21, 112, 239, .10);
    }


    .gov-form-card .form-control::placeholder {
        color: #98a2b3;
    }


    /* ========================================
           FILE INPUT
        ======================================== */

    .gov-form-card input[type="file"].form-control {
        padding: 8px 10px;
        cursor: pointer;
        background: #f9fafb;
    }


        .gov-form-card input[type="file"].form-control::file-selector-button {
            margin-left: 10px;
            padding: 8px 14px;
            border: 0;
            border-radius: 6px;
            background: #eef4ff;
            color: #175cd3;
            font-weight: 600;
            cursor: pointer;
            transition: .2s ease;
        }


            .gov-form-card input[type="file"].form-control::file-selector-button:hover {
                background: #dbeeff;
            }


    /* ========================================
           TABLE
        ======================================== */

    .gov-table-card table {
        vertical-align: middle;
    }


    .gov-table-card th {
        white-space: nowrap;
        vertical-align: middle;
    }


    .gov-table-card td {
        vertical-align: middle;
    }


    .gov-title-cell {
        min-width: 180px;
        max-width: 300px;
        line-height: 1.7;
        word-break: break-word;
    }


    .description-column {
        min-width: 240px;
    }


    /* ========================================
           DESCRIPTION
        ======================================== */

    .gov-description-cell {
        max-width: 350px;
        min-width: 240px;
        line-height: 1.7;
        color: #475467;
        word-break: break-word;
    }


    .gov-description-preview {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        white-space: normal;
        word-break: break-word;
    }


    .gov-description-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        margin-top: 8px;
        padding: 5px 10px;
        border: 0;
        border-radius: 6px;
        background: #eff8ff;
        color: #175cd3;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
    }


        .gov-description-more:hover {
            background: #dbeeff;
            color: #1849a9;
            transform: translateY(-1px);
        }


        .gov-description-more i {
            font-size: 11px;
        }


    /* ========================================
           EMPTY CELL
        ======================================== */

    .gov-empty-cell {
        color: #98a2b3;
        font-size: 14px;
    }


    /* ========================================
           DETAILS MODAL
        ======================================== */

    .gov-details-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 10000;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(16, 24, 40, .70);
        backdrop-filter: blur(3px);
    }


        .gov-details-modal.is-open {
            display: flex;
        }


    .gov-details-modal__content {
        width: min(850px, 95vw);
        max-height: 85vh;
        overflow: hidden;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, .25);
        animation: govModalIn .2s ease;
    }


    .gov-details-modal__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #eaecf0;
    }


    .gov-details-modal__title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        color: #101828;
        font-size: 17px;
        font-weight: 700;
    }


        .gov-details-modal__title i {
            color: #1570ef;
        }


    .gov-details-modal__close {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 0;
        border-radius: 50%;
        background: #fee4e2;
        color: #b42318;
        cursor: pointer;
        transition: all .2s ease;
    }


        .gov-details-modal__close:hover {
            background: #fecdca;
            transform: rotate(5deg);
        }


    .gov-details-modal__body {
        padding: 24px;
        max-height: calc(85vh - 75px);
        overflow-y: auto;
        direction: rtl;
        text-align: right;
    }


        .gov-details-modal__body.ltr {
            direction: ltr;
            text-align: left;
        }


    .gov-details-modal__text {
        margin: 0;
        color: #344054;
        font-size: 15px;
        line-height: 2;
        white-space: pre-wrap;
        word-break: break-word;
    }


    /* ========================================
           PDF MODAL
        ======================================== */

    .gov-pdf-modal {
        display: none;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, .85);
        padding: 20px;
    }


    .gov-pdf-close {
        position: absolute;
        top: 16px;
        left: 20px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #fff;
        font-size: 18px;
        background: #b42318;
        border-radius: 50%;
        transition: all .2s ease;
        z-index: 2;
    }


        .gov-pdf-close:hover {
            background: #912018;
            transform: rotate(5deg);
