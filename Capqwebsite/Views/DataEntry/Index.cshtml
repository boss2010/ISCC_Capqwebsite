@model List<EF.Models.WebsiteTypeDetail>

<!-- Page Header -->
<div class="gov-page-header">
    <div class="container">
        <div class="gov-page-header__inner">
            <div class="gov-page-header__title">
                <span class="gov-page-header__icon"><i class="fas fa-edit"></i></span>
                <div>
                    <span class="gov-page-header__eyebrow">لوحة التحكم</span>
                    <h1 class="gov-page-header__h1">إدارة @(ViewBag.TypeAr ?? "البيانات")</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid gov-inner-page">
    <div class="container">

        @if (TempData["WarningMessage"] != null)
        {
            <div class="gov-alert gov-alert--warning mb-4">
                <i class="fas fa-exclamation-triangle ml-2"></i>
                @TempData["WarningMessage"]
            </div>
        }

        <!-- Add Form Card -->
        <div class="gov-form-card mb-4">
            <div class="gov-form-card__header">
                <span class="gov-form-card__icon"><i class="fas fa-plus-circle"></i></span>
                <h2 class="gov-form-card__title">إضافة @(ViewBag.TypeAr ?? "")</h2>
            </div>
            <div class="gov-form-card__body">
                <form asp-controller="DataEntry" id="myForm" asp-action="Index" method="post" enctype="multipart/form-data">
                    <input name="WebsitetypeID" id="WebsitetypeID" type="hidden" value="@(ViewBag.ID ?? "0")" />
                    @if (ViewBag.ID != 9)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.TitleAr</label>
                            <input name="TitleAr" type="text" class="form-control" placeholder="@ViewBag.TitleAr">
                        </div>
                    }
                    @if (ViewBag.ID == 12 || ViewBag.ID == 17)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.TitleEn</label>
                            <input name="TitleEn" type="text" class="form-control" placeholder="@ViewBag.TitleEn">
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10 || ViewBag.ID == 11 || ViewBag.ID == 12)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.descAr</label>
                            <textarea name="descAr" rows="3" class="form-control" autocomplete="off"></textarea>
                        </div>
                    }
                    @if (ViewBag.ID == 12 || ViewBag.ID == 17)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.descEn</label>
                            <textarea name="descEn" rows="3" class="form-control" autocomplete="off"></textarea>
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.Date</label>
                            <input name="Date" type="date" class="form-control" />
                        </div>
                    }
                    @if ((ViewBag.ID == 8) || (ViewBag.ID != 15 && ViewBag.ID != 16 && ViewBag.ID != 12 && ViewBag.ID != 14 && ViewBag.ID != 6 && ViewBag.ID != 10 && ViewBag.ID != 17))
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.filepath</label>
                            <input name="imageFile" type="file" class="form-control">
                        </div>
                    }
                    @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 15 || ViewBag.ID == 16 || ViewBag.ID == 12 || ViewBag.ID == 14 || ViewBag.ID == 6 || ViewBag.ID == 17)
                    {
                        <div class="form-group">
                            <label class="gov-label">@ViewBag.linkURL</label>
                            <input name="linkURL" type="text" class="form-control" />
                        </div>
                    }
                    <div class="gov-form-actions">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-save ml-1"></i> حفظ
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Data Table Card -->
        <div class="gov-table-card">
            <div class="gov-table-card__header">
                <span class="gov-form-card__icon"><i class="fas fa-list"></i></span>
                <h2 class="gov-form-card__title">البيانات المدخلة</h2>
            </div>
            <div class="gov-table-card__body">
                <div class="table-responsive" id="div2">
                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                @if (ViewBag.ID != 9)
                                {
                                    <th>@ViewBag.TitleAr</th>
                                }
                                @if (ViewBag.ID == 12 || ViewBag.ID == 17)
                                {
                                    <th>@ViewBag.TitleEn</th>
                                }
                                @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10 || ViewBag.ID == 11 || ViewBag.ID == 12)
                                {
                                    <th>@ViewBag.descAr</th>
                                }
                                @if (ViewBag.ID == 7 || ViewBag.ID == 12 || ViewBag.ID == 17)
                                {
                                    <th>@ViewBag.descEn</th>
                                }
                                @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10)
                                {
                                    <th>@ViewBag.Date</th>
                                }
                                @if ((ViewBag.ID == 8) || (ViewBag.ID != 15 && ViewBag.ID != 16 && ViewBag.ID != 12 && ViewBag.ID != 14 && ViewBag.ID != 6 && ViewBag.ID != 10 && ViewBag.ID != 17))
                                {
                                    <th>الصورة / الملف</th>
                                }
                                @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 15 || ViewBag.ID == 16 || ViewBag.ID == 12 || ViewBag.ID == 14 || ViewBag.ID == 6 || ViewBag.ID == 17)
                                {
                                    <th>@ViewBag.linkURL</th>
                                }
                                <th style="width:120px;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        @if (ViewBag.ID != 9)
                                        {
                                            <td>@item.TitleAr</td>
                                        }
                                        @if (ViewBag.ID == 7 || ViewBag.ID == 12 || ViewBag.ID == 17)
                                        {
                                            <td>@item.TitleEn</td>
                                        }
                                        @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10 || ViewBag.ID == 11 || ViewBag.ID == 12 || ViewBag.ID == 17)
                                        {
                                            <td>@item.descAr</td>
                                        }
                                        @if (ViewBag.ID == 7 || ViewBag.ID == 12)
                                        {
                                            <td>@item.descEn</td>
                                        }
                                        @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 10)
                                        {
                                            <td>
                                                @if (item.Date != null)
                                                {
                                                    @item.Date.Value.ToString("yyyy-MM-dd")
                                                }
                                            </td>
                                        }
                                        @if ((ViewBag.ID == 8) || (ViewBag.ID != 15 && ViewBag.ID != 16 && ViewBag.ID != 12 && ViewBag.ID != 14 && ViewBag.ID != 6 && ViewBag.ID != 10 && ViewBag.ID != 17))
                                        {
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.filepath))
                                                {
                                                    if (item.filepath.EndsWith(".pdf"))
                                                    {
                                                        <a href="#" class="gov-file-badge openPdf" data-pdf="@item.filepath">
                                                            <i class="fas fa-file-pdf ml-1"></i>@item.TitleAr
                                                        </a>
                                                    }
                                                    else if (item.filepath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                                             item.filepath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                                             item.filepath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                                                             item.filepath.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) ||
                                                             item.filepath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) ||
                                                             item.filepath.EndsWith(".bmp", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <img src="@item.filepath" alt="صورة" class="gov-table-thumb" />
                                                    }
                                                }
                                            </td>
                                        }
                                        @if (ViewBag.ID == 7 || ViewBag.ID == 8 || ViewBag.ID == 15 || ViewBag.ID == 16 || ViewBag.ID == 12 || ViewBag.ID == 14 || ViewBag.ID == 6 || ViewBag.ID == 17)
                                        {
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.linkURL))
                                                {
                                                    <a href="@item.linkURL" target="_blank" class="gov-link">
                                                        <i class="fas fa-external-link-alt ml-1"></i>فتح الرابط
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="gov-empty-cell">—</span>
                                                }
                                            </td>
                                        }
                                        <td>
                                            <div class="gov-actions-cell">
                                                <a href="@Url.Action("Edit", new { id = item.ID, IdType = ViewBag.ID })"
                                                   class="btn btn-sm gov-btn-edit" title="تعديل">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", "DataEntry", new { id = item.ID })"
                                                   class="btn btn-sm gov-btn-delete" title="حذف"
                                                   onclick="return confirm('هل أنت متأكد من الحذف؟');">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PDF Modal -->
<div id="pdfModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
    <div id="closeModal" style="position:absolute; top:16px; left:20px; cursor:pointer; color:#fff; font-size:18px; width:40px; height:40px; background:var(--gov-danger,#b42318); border-radius:50%; display:flex; align-items:center; justify-content:center;">
        <i class="fas fa-times"></i>
    </div>
    <iframe id="pdfFrame" style="width:min(92vw,1100px); height:min(80vh,760px); margin:6vh auto; display:block; border:none; border-radius:8px; background:#fff;"></iframe>
</div>

<script>
    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById("pdfFrame");
    const closeBtn = document.getElementById("closeModal");
    document.querySelectorAll(".openPdf").forEach(link => {
        link.addEventListener("click", function (e) {
            e.preventDefault();
            frame.src = this.getAttribute("data-pdf");
            modal.style.display = "flex";
        });
    });
    closeBtn.onclick = function () {
        modal.style.display = "none";
        frame.src = "";
    };
</script>
