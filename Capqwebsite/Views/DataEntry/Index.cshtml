<script>

    /* =====================================================
       PDF MODAL
    ====================================================== */

    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById("pdfFrame");
    const closeBtn = document.getElementById("closeModal");


    document.querySelectorAll(".openPdf").forEach(link => {

        link.addEventListener("click", function (e) {

            e.preventDefault();

            const pdfUrl = this.getAttribute("data-pdf");

            if (!pdfUrl) {
                return;
            }

            frame.src = pdfUrl;

            modal.style.display = "flex";

            document.body.style.overflow = "hidden";

        });

    });


    function closePdfModal() {

        modal.style.display = "none";

        frame.src = "";

        document.body.style.overflow = "";

    }


    closeBtn.onclick = function () {

        closePdfModal();

    };


    modal.addEventListener("click", function (e) {

        if (e.target === modal) {

            closePdfModal();

        }

    });



    /* =====================================================
       DETAILS MODAL
    ====================================================== */

    const detailsModal =
        document.getElementById("detailsModal");

    const detailsModalTitle =
        document.getElementById("detailsModalTitle");

    const detailsModalText =
        document.getElementById("detailsModalText");

    const detailsModalBody =
        document.getElementById("detailsModalBody");

    const closeDetailsModal =
        document.getElementById("closeDetailsModal");


    /* Open Details */

    document.querySelectorAll(".openDetails").forEach(button => {

        button.addEventListener("click", function () {

            const title =
                this.getAttribute("data-title") ||
                "التفاصيل";

            const content =
                this.getAttribute("data-content") ||
                "";

            const direction =
                this.getAttribute("data-direction") ||
                "rtl";


            /* Title */

            if (direction === "ltr") {

                detailsModalTitle.innerHTML = `
                    <i class="fas fa-align-left"></i>
                    ${title}
                `;

            }
            else {

                detailsModalTitle.innerHTML = `
                    <i class="fas fa-align-right"></i>
                    ${title}
                `;

            }


            /* Content */

            detailsModalText.textContent = content;


            /* Direction */

            if (direction === "ltr") {

                detailsModalBody.classList.add("ltr");

            }
            else {

                detailsModalBody.classList.remove("ltr");

            }


            /* Open */

            detailsModal.classList.add("is-open");

            document.body.style.overflow = "hidden";

        });

    });


    /* Close Details */

    function closeDetails() {

        detailsModal.classList.remove("is-open");

        detailsModalText.textContent = "";

        document.body.style.overflow = "";

    }


    closeDetailsModal.addEventListener(
        "click",
        closeDetails
    );


    /* Click Outside */

    detailsModal.addEventListener("click", function (e) {

        if (e.target === detailsModal) {

            closeDetails();

        }

    });


    /* Escape */

    document.addEventListener("keydown", function (e) {

        if (e.key === "Escape") {

            if (
                detailsModal.classList.contains("is-open")
            ) {

                closeDetails();

            }


            if (
                modal.style.display === "flex"
            ) {

                closePdfModal();

            }

        }

    });

</script>
