@{
	Layout = null;
}


<link href="~/fontawesome-free-5.15.4-web/css/all.min.css" rel="stylesheet" />
<link href="~/fontawesome-free-5.15.4-web/css/all.css" rel="stylesheet" />
<link href="~/css/login.css" rel="stylesheet" />
<link href="~/css/government-login.css" rel="stylesheet"   />


<div class="container">
	<div class="screen">
		<div class="screen__content">
			<div class="gov-login-heading">
				<div class="gov-login-heading__logo">
					<img src="~/img/logo-capq.png" alt="الإدارة المركزية للحجر الزراعي" />
				</div>
				<h1 class="gov-login-heading__title">البوابة الرسمية للحجر الزراعي</h1>
				<span class="gov-login-heading__subtitle">تسجيل دخول المستخدمين المصرح لهم</span>
			</div>
			<form class="login" method="post" action="GoDataEntryMenu">
				<div class="login__field">

					<input name="userName" type="text" class="login__input" placeholder="اسم المستخدم">
					<i class="login__icon fas fa-user"></i>
				</div>
				<div class="login__field">

					<input name="password" type="password" class="login__input" placeholder="كلمة السر">
					<i class="login__icon fas fa-lock"></i>
				</div>
				<button class="button login__submit" type="submit">
					<i class="button__icon fas fa-chevron-left"></i>
					<span class="button__text">تسجيل الدخول</span>

				</button>
			</form>
		
		</div>
		<div class="screen__background">
			<div class="social-login">
				
				<div class="social-icons">
					
					<a href="#" class="social-login__icon fab fa-facebook"></a>
					<a href="#" class="social-login__icon fab fa-twitter"></a>
				</div>
			</div>
		</div>
	</div>
</div>
