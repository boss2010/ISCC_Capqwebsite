@model List<ViewModels.Im_InitiatorVM>

<link rel="stylesheet" href="~/css/procedure-search.css" asp-append-version="true" />
<div class="procedure-page" dir="rtl">
    <header class="procedure-heading">
        <div class="procedure-container">
            <nav class="procedure-breadcrumb" aria-label="مسار الصفحة"><a href="@Url.Action("Index", "Home")">الرئيسية</a><span>›</span> اشتراطات الاستيراد</nav>
            <div class="procedure-title"><div><span>الاستيراد</span><h1>اشتراطات الاستيراد</h1></div><div class="procedure-title-icon"><i class="fas fa-balance-scale" aria-hidden="true"></i></div></div>
        </div>
    </header>
    <div class="procedure-content procedure-container">
        <section class="procedure-panel" aria-labelledby="procedure-search-title">
            <div class="procedure-panel-head"><div><h2 id="procedure-search-title">البحث في اشتراطات الاستيراد</h2><p>اختر المنشأ والنبات للوصول إلى الاشتراطات والبيانات المرتبطة بهما.</p></div><span class="procedure-badge">استعلام إلكتروني</span></div>
            <div class="procedure-search-area">
                <form id="importingSearchForm">
                    <div class="procedure-form-grid">
                        <div class="procedure-field"><label for="ImInitiatorListId">المنشأ</label>
                            @Html.DropDownList("ImInitiatorID", (IEnumerable<SelectListItem>)ViewData["ImInitiatorList"], "-- اختر المنشأ --", new { id = "ImInitiatorListId", @class = "form-control" })
                        </div>
                        <div class="procedure-field"><label for="ItemListId">النبات</label>
                            @Html.DropDownList("ItemID", (IEnumerable<SelectListItem>)ViewData["ItemList"], "-- اختر النبات --", new { id = "ItemListId", @class = "form-control" })
                        </div>
                        <button id="btnsearch" class="procedure-search-btn" type="submit">بحث</button>
                    </div>
                </form>
                <div class="procedure-helper"><i class="fas fa-info-circle" aria-hidden="true"></i><span>يرجى تحديد المنشأ والنبات ثم الضغط على «بحث» لعرض اشتراطات الاستيراد المتاحة.</span></div>
                <div id="divdata" class="procedure-results" aria-live="polite">
                    @if (Model != null && Model.Any())
                    {
                        <partial name="_PartialImporting.cshtml" model="Model" />
                    }
                </div>
            </div>
        </section>
    </div>
</div>
<!-- jQuery -->
<script src="~/js/jquery-3.4.1.min.js"></script>


<script>

	$(document).ready(function () {

		// =====================================================
		// Select2
		// =====================================================

		$("#ImInitiatorListId").select2({
			placeholder: "-- اختار --",
			allowClear: true,
			width: "100%"
		});


		$("#ItemListId").select2({
			placeholder: "-- اختار --",
			allowClear: true,
			width: "100%"
		});


		// =====================================================
		// عند تغيير المنشأ
		// جلب النباتات الخاصة بالمنشأ
		// =====================================================

		$("#ImInitiatorListId").on("change", function () {

			var initiatorId = $(this).val();

			// تفريغ النتائج
			$("#divdata").empty();

			// تفريغ قائمة النباتات
			$("#ItemListId").empty();

			// إضافة الخيار الافتراضي
			$("#ItemListId").append(
				$("<option></option>")
					.val("")
					.text("-- اختار --")
			);


			// إذا لم يتم اختيار منشأ
			if (!initiatorId || initiatorId === "0") {

				$("#ItemListId").trigger("change.select2");

				return;
			}


			// إظهار Loading
			$("#ItemListId").prop("disabled", true);

			$("#ItemListId").append(
				$("<option></option>")
					.val("")
					.text("جاري تحميل النباتات...")
			);

			$("#ItemListId").trigger("change.select2");


			// =================================================
			// AJAX
			// =================================================

			$.ajax({

				url: "/ImportingProcedure/GetItemsByInitiator",

				type: "GET",

				data: {
					ImInitiatorID: initiatorId
				},

				success: function (data) {

					// تفريغ القائمة
					$("#ItemListId").empty();

					// الخيار الافتراضي
					$("#ItemListId").append(
						$("<option></option>")
							.val("")
							.text("-- اختار --")
					);


					// إضافة النباتات
					$.each(data, function (index, item) {

						$("#ItemListId").append(
							$("<option></option>")
								.val(item.id)
								.text(item.name_Ar)
						);

					});


					// تفعيل القائمة
					$("#ItemListId").prop("disabled", false);

					$("#ItemListId").trigger("change.select2");

				},

				error: function (xhr, status, error) {

					console.error(
						"Error loading items:",
						error
					);


					$("#ItemListId").empty();

					$("#ItemListId").append(
						$("<option></option>")
							.val("")
							.text("-- حدث خطأ في تحميل النباتات --")
					);

					$("#ItemListId").prop("disabled", false);

					$("#ItemListId").trigger("change.select2");

				}

			});

		});


		// =====================================================
		// عند تغيير النبات
		// جلب الاشتراطات
		// =====================================================

		$("#ItemListId").on("change", function () {

			var initiatorId =
				$("#ImInitiatorListId").val();

			var itemId =
				$(this).val();


			// تفريغ النتائج
			$("#divdata").empty();


			// التحقق من اختيار المنشأ والنبات
			if (
				!initiatorId ||
				initiatorId === "0" ||
				!itemId ||
				itemId === "0"
			) {

				return;
			}


			// =================================================
			// Loading
			// =================================================

			$("#divdata").html(
				'<div class="text-center p-4">' +
					'<span>جاري تحميل الاشتراطات...</span>' +
				'</div>'
			);


			// =================================================
			// AJAX
			// =================================================

			$.ajax({

				url: "/ImportingProcedure/GetConstraints",

				type: "GET",

				data: {
					ImInitiatorID: initiatorId,
					ItemID: itemId
				},

				success: function (result) {

					$("#divdata").html(result);

				},

				error: function (xhr, status, error) {

					console.error(
						"Error loading constraints:",
						error
					);


					$("#divdata").html(
						'<div class="alert alert-danger text-center">' +
							'حدث خطأ أثناء تحميل الاشتراطات.' +
						'</div>'
					);

				}

			});

		});


		// =====================================================
		// زر البحث
		// =====================================================

		$("#importingSearchForm").on("submit", function (e) {

			e.preventDefault();


			var initiatorId =
				$("#ImInitiatorListId").val();

			var itemId =
				$("#ItemListId").val();


			if (
				!initiatorId ||
				initiatorId === "0"
			) {

				$("#divdata").html(
					'<div class="alert alert-warning text-center">' +
						'برجاء اختيار المنشأ.' +
					'</div>'
				);

				return;
			}


			if (
				!itemId ||
				itemId === "0"
			) {

				$("#divdata").html(
					'<div class="alert alert-warning text-center">' +
						'برجاء اختيار النبات.' +
					'</div>'
				);

				return;
			}


			// تحميل الاشتراطات
			loadConstraints(
				initiatorId,
				itemId
			);

		});


		// =====================================================
		// Function
		// تحميل الاشتراطات
		// =====================================================

		function loadConstraints(
			initiatorId,
			itemId
		) {

			$("#divdata").html(
				'<div class="text-center p-4">' +
					'<span>جاري تحميل الاشتراطات...</span>' +
				'</div>'
			);


			$.ajax({

				url: "/ImportingProcedure/GetConstraints",

				type: "GET",

				data: {
					ImInitiatorID: initiatorId,
					ItemID: itemId
				},

				success: function (result) {

					$("#divdata").html(result);

				},

				error: function (xhr, status, error) {

					console.error(
						"Error loading constraints:",
						error
					);


					$("#divdata").html(
						'<div class="alert alert-danger text-center">' +
							'حدث خطأ أثناء تحميل الاشتراطات.' +
						'</div>'
					);

				}

			});

		}

	});

</script>