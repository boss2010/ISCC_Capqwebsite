						<option value="">___</option>
						<option value="">___</option>
						<option value="">__</option>
						<option value="">__</option>
					</select>


				</div>
			</div>
			<br />
			<div class="row">
				<div class="col-md-4"></div>
				<div class="col-md-4">
					<center style="margin-bottom: 15px;">

						<input id="btnsearch" type="submit" class="bg-primary-deep text-primary-foreground py-2 px-4" name="btnSave" value="بحث">
					</center>
				</div>
				<div class="col-md-4"></div>
			</div>
		</form>
		<br />
		
		@* //////////////////////////partial view 24/5/2025////////////////////////// *@
	
			<div id="divdata">
				@if (@Model != null)
				{
					<partial name="_PartialImporting.cshtml" for="@Model" />
				}
			</div>
			<br />
	
		
	</div>
</div>
<script src="~/js/jquery-3.4.1.min.js"></script>

<script>
	$(document).ready(function () {
		$("#ImInitiatorListId").select2({
			placeholder: "-- اختار --",
			allowClear: true
		});
		$("#ItemListId").select2({
			placeholder: "-- اختار --",
			allowClear: true
		});


			$("#ItemListId").on("change", function () {
		$("#resultsTable").empty();});
				$("#ImInitiatorListId").on("change", function () {
		$("#resultsTable").empty();});
	});


</script>