<!-- Contact Start -->
<div class="container-fluid bg-light">
	<div class="container pt-5">
		<form class="text-start">
			<div class="row">
				<div class="col-md-4">

					<label class="label lbl-style ">المنشأ</label>

					<br>
					<br>
					@* /////////////rrrr_13-5-2025///////////////// *@

					@Html.DropDownList("ImInitiatorID", (IEnumerable
															<SelectListItem>)ViewData["ImInitiatorList"], "-- اختار --", new { @id = "ImInitiatorListId", @class = "form-control" })





				</div>
				<div class="col-md-4">

					<label class="label lbl-style ">النباتات</label>

					<br>
					<br>
					@Html.DropDownList("ItemID", (IEnumerable
															<SelectListItem>)ViewData["ItemList"], "-- اختار --", new { @id = "ItemListId", @class = "form-control" })




				</div>
				<div style="display: none;" class="col-md-4">

					<label class="label lbl-style ">مسمي مختصر</label>

					<br>
