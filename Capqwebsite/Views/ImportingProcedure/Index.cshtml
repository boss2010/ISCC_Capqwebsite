@model List<ViewModels.Im_InitiatorVM>

<!-- Page Header Start -->
<div class="gov-page-header">
	<div class="container">
		<div class="gov-page-header__inner">
			<div class="gov-page-header__title">
				<span class="gov-page-header__icon">
					<i class="fas fa-balance-scale"></i>
				</span>
				<div>
					<span class="gov-page-header__eyebrow">
						الاستيراد
					</span>
					<h1 class="gov-page-header__h1">
						اشتراطات الاستيراد
					</h1>
				</div>
			</div>
			<nav class="gov-breadcrumb">
				<a href="/Home/HomePage/Index" class="gov-breadcrumb__link">
					الرئيسية
				</a>
				<i class="fas fa-chevron-left gov-breadcrumb__sep"></i>
				<span class="gov-breadcrumb__current">
					اشتراطات الاستيراد
				</span>
			</nav>
		</div>
	</div>
</div>
<!-- Page Header End -->


<br />


<!-- Importing Procedure Start -->
<div class="mx-auto max-w-7xl px-6">
<div class="container-fluid bg-light">
	<div class="container pt-5">
		<form id="importingSearchForm" class="text-start">
			<div class="row">				
				<div class="col-md-4">
					<label class="label lbl-style">
						المنشأ
					</label>
					<br />
					<br />
					@Html.DropDownList(
					"ImInitiatorID",
										(IEnumerable<SelectListItem>)ViewData["ImInitiatorList"],
										"-- اختار --",
										new
										{
											@id = "ImInitiatorListId",
											@class = "form-control"
										}
										)
				</div>
				<!-- ========================= -->
				<!-- النباتات -->
				<!-- ========================= -->
				<div class="col-md-4">

					<label class="label lbl-style">
						النباتات
					</label>
					<br />
					<br />

					@Html.DropDownList(
										"ItemID",
										(IEnumerable<SelectListItem>)ViewData["ItemList"],
										"-- اختار --",
										new
										{
											@id = "ItemListId",
											@class = "form-control"
										}
										)
				</div>


				<!-- ========================= -->
				<!-- المسمى المختصر -->
				<!-- ========================= -->

				<div style="display:none;" class="col-md-4">

					<label class="label lbl-style">
						مسمى مختصر
					</label>

					<br />
					<br />

					<select class="operator form-control">
						<option value="">
							مسمى مختصر
						</option>
						<option value="">___</option>
						<option value="">___</option>
						<option value="">__</option>
						<option value="">__</option>
					</select>

				</div>

			</div>


			<br />


			<!-- ========================= -->
			<!-- زر البحث -->
			<!-- ========================= -->

			<div class="row">

				<div class="col-md-4"></div>

				<div class="col-md-4">

					<center style="margin-bottom:15px;">

						<input id="btnsearch"
							   type="submit"
							   class="bg-primary-deep text-primary-foreground py-2 px-4"
							   name="btnSave"
							   value="بحث" />

					</center>

				</div>

				<div class="col-md-4"></div>

			</div>

		</form>


		<br />


		<!-- ========================= -->
		<!-- النتائج -->
		<!-- ========================= -->

		<div id="divdata">

			@if (Model != null && Model.Any())
			{
				<partial name="_PartialImporting.cshtml" model="Model" />
			}

		</div>


		<br />

	</div>

</div>
</div>
<!-- Importing Procedure End -->
<!-- jQuery -->
<script src="~/js/jquery-3.4.1.min.js"></script>


<script>

	$(document).ready(function () {

		// =====================================================
		// Select2
		// =====================================================

		$("#ImInitiatorListId").select2({
			placeholder: "-- اختار --",
			allowClear: true,
			width: "100%"
		});


		$("#ItemListId").select2({
			placeholder: "-- اختار --",
			allowClear: true,
			width: "100%"
		});


		// =====================================================
		// عند تغيير المنشأ
		// جلب النباتات الخاصة بالمنشأ
		// =====================================================

		$("#ImInitiatorListId").on("change", function () {

			var initiatorId = $(this).val();

			// تفريغ النتائج
			$("#divdata").empty();

			// تفريغ قائمة النباتات
			$("#ItemListId").empty();

			// إضافة الخيار الافتراضي
			$("#ItemListId").append(
				$("<option></option>")
					.val("")
					.text("-- اختار --")
			);


			// إذا لم يتم اختيار منشأ
			if (!initiatorId || initiatorId === "0") {

				$("#ItemListId").trigger("change.select2");

				return;
			}


			// إظهار Loading
			$("#ItemListId").prop("disabled", true);

			$("#ItemListId").append(
				$("<option></option>")
					.val("")
					.text("جاري تحميل النباتات...")
			);

			$("#ItemListId").trigger("change.select2");


			// =================================================
			// AJAX
			// =================================================

			$.ajax({

				url: "/ImportingProcedure/GetItemsByInitiator",

				type: "GET",

				data: {
					ImInitiatorID: initiatorId
				},

				success: function (data) {

					// تفريغ القائمة
					$("#ItemListId").empty();

					// الخيار الافتراضي
					$("#ItemListId").append(
						$("<option></option>")
							.val("")
							.text("-- اختار --")
					);


					// إضافة النباتات
					$.each(data, function (index, item) {

						$("#ItemListId").append(
							$("<option></option>")
								.val(item.id)
								.text(item.name_Ar)
						);

					});


					// تفعيل القائمة
					$("#ItemListId").prop("disabled", false);

					$("#ItemListId").trigger("change.select2");

				},

				error: function (xhr, status, error) {

					console.error(
						"Error loading items:",
						error
					);


					$("#ItemListId").empty();

					$("#ItemListId").append(
						$("<option></option>")
							.val("")
							.text("-- حدث خطأ في تحميل النباتات --")
					);

					$("#ItemListId").prop("disabled", false);

					$("#ItemListId").trigger("change.select2");

				}

			});

		});


		// =====================================================
		// عند تغيير النبات
		// جلب الاشتراطات
		// =====================================================

		$("#ItemListId").on("change", function () {

			var initiatorId =
				$("#ImInitiatorListId").val();

			var itemId =
				$(this).val();


			// تفريغ النتائج
			$("#divdata").empty();


			// التحقق من اختيار المنشأ والنبات
			if (
				!initiatorId ||
				initiatorId === "0" ||
				!itemId ||
				itemId === "0"
			) {

				return;
			}


			// =================================================
			// Loading
			// =================================================

			$("#divdata").html(
				'<div class="text-center p-4">' +
					'<span>جاري تحميل الاشتراطات...</span>' +
				'</div>'
			);


			// =================================================
			// AJAX
			// =================================================

			$.ajax({

				url: "/ImportingProcedure/GetConstraints",

				type: "GET",

				data: {
					ImInitiatorID: initiatorId,
					ItemID: itemId
				},

				success: function (result) {

					$("#divdata").html(result);

				},

				error: function (xhr, status, error) {

					console.error(
						"Error loading constraints:",
						error
					);


					$("#divdata").html(
						'<div class="alert alert-danger text-center">' +
							'حدث خطأ أثناء تحميل الاشتراطات.' +
						'</div>'
					);

				}

			});

		});


		// =====================================================
		// زر البحث
		// =====================================================

		$("#importingSearchForm").on("submit", function (e) {

			e.preventDefault();


			var initiatorId =
				$("#ImInitiatorListId").val();

			var itemId =
				$("#ItemListId").val();


			if (
				!initiatorId ||
				initiatorId === "0"
			) {

				$("#divdata").html(
					'<div class="alert alert-warning text-center">' +
						'برجاء اختيار المنشأ.' +
					'</div>'
				);

				return;
			}


			if (
				!itemId ||
				itemId === "0"
			) {

				$("#divdata").html(
					'<div class="alert alert-warning text-center">' +
						'برجاء اختيار النبات.' +
					'</div>'
				);

				return;
			}


			// تحميل الاشتراطات
			loadConstraints(
				initiatorId,
				itemId
			);

		});


		// =====================================================
		// Function
		// تحميل الاشتراطات
		// =====================================================

		function loadConstraints(
			initiatorId,
			itemId
		) {

			$("#divdata").html(
				'<div class="text-center p-4">' +
					'<span>جاري تحميل الاشتراطات...</span>' +
				'</div>'
			);


			$.ajax({

				url: "/ImportingProcedure/GetConstraints",

				type: "GET",

				data: {
					ImInitiatorID: initiatorId,
					ItemID: itemId
				},

				success: function (result) {

					$("#divdata").html(result);

				},

				error: function (xhr, status, error) {

					console.error(
						"Error loading constraints:",
						error
					);


					$("#divdata").html(
						'<div class="alert alert-danger text-center">' +
							'حدث خطأ أثناء تحميل الاشتراطات.' +
						'</div>'
					);

				}

			});

		}

	});

</script>