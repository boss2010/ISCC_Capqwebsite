@if (TempData.Peek("Error") != null)
{
    <div class="alert alert-danger">
        @TempData.Peek("Error")
    </div>
}
<br />

<div class="container text-center">

    <h3>اختر نوع الدفع</h3>

    <br />

    <button class="btn btn-primary btn-lg"
            onclick="location.href='@Url.Action("GeneralPayment", "Fees")'">
        رسوم / خدمات
    </button>

    <button class="btn btn-success btn-lg"
            onclick="location.href='@Url.Action("InspectionPayment", "Fees")'">
        معاينة وعينات
    </button>

    @if (Context.Session.GetString("UserSession") != null)
    {
        <hr />
        <h4>متابعة عمليات الدفع الناجحة</h4>
        <br />

        <a asp-action="GovernmentPayments" class="btn btn-outline-primary btn-lg">
            عمليات الدفع الحكومي
        </a>

        <a asp-action="PrivatePayments" class="btn btn-outline-success btn-lg">
            عمليات الدفع الخاص
        </a>
    }

</div>

@section Scripts
{
<script>
    setTimeout(function () {
        $('.alert').fadeOut();
    }, 10000);
</script>
}
