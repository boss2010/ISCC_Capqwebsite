@{
    ViewBag.Title = "NBE Payment";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>NBE Payment</title>

    <!-- ========================================================= -->
    <!-- NBE CHECKOUT SDK -->
    <!-- ========================================================= -->

    <script src="https://nbe.gateway.mastercard.com/static/checkout/checkout.min.js"
            data-error="nbeCheckoutErrorCallback"
            data-cancel="nbeCheckoutCancelCallback">
    </script>



    <!-- ========================================================= -->
    <!-- JQUERY -->
    <!-- ========================================================= -->



    <script src="~/js/jquery-3.4.1.min.js"></script>

    <!-- ========================================================= -->
    <!-- BOOTSTRAP -->
    <!-- ========================================================= -->


    <link href="~/bootstrap.min.css" rel="stylesheet" />


    <script src="~/bootstrap.min.js"></script>


    <!-- ========================================================= -->
    <!-- NBE ERROR / CANCEL CALLBACKS -->
    <!-- ========================================================= -->

    <script>

        function nbeCheckoutErrorCallback(error) { }


        function nbeCheckoutCancelCallback() { }

    </script>


    <!-- ========================================================= -->
    <!-- PAYMENT SCRIPT -->
    <!-- ========================================================= -->

    <script>

        $(document).ready(function () {

            /* ===================================================== */
            /* GET SESSION ID */
            /* ===================================================== */

            var sessionId = $("#SessionId").val();


            /* ===================================================== */
            /* VALIDATE SESSION */
            /* ===================================================== */

            if (!sessionId) {
                return;
            }


            /* ===================================================== */
            /* OPEN PAYMENT PAGE */
            /* ===================================================== */

            function openPaymentPage() {

                try {

                    var payment = Checkout.showPaymentPage();


                    /*
                     * بعض إصدارات الـ SDK
                     * ممكن ترجع Promise
                     */

                    if (payment &&
                        typeof payment.catch === "function") {

                        payment.catch(function (error) { });

                    }

                }
                catch (error) { }
            }


            /* ===================================================== */
            /* CHECKOUT READY */
            /* ===================================================== */

            function checkoutReady() {

                /*
                 * فتح صفحة الدفع تلقائياً
                 */

                openPaymentPage();

            }


            /* ===================================================== */
            /* CHECKOUT CONFIGURATION */
            /* ===================================================== */

            try {

                /*
                 * مهم جداً:
                 *
                 * مع INITIATE_CHECKOUT الجديد
                 * نرسل الـ Session فقط.
                 *
                 * لا نرسل order هنا.
                 * لا نرسل amount هنا.
                 * لا نرسل currency هنا.
                 * لا نرسل interaction هنا.
                 *
                 * هذه البيانات تم إرسالها بالفعل
                 * في Create_Session().
                 */

                var configuration = Checkout.configure({

                    session: {
                        id: sessionId
                    }

                });


                /* ================================================= */
                /* HANDLE PROMISE */
                /* ================================================= */

                if (configuration &&
                    typeof configuration.then === "function") {


                    configuration
                        .then(function () {

                            checkoutReady();

                        })
                        .catch(function (error) { });


                }
                else {

                    /*
                     * بعض الإصدارات لا ترجع Promise
                     */

                    checkoutReady();

                }

            }
            catch (error) { }

        });

    </script>

</head>


<body>

    <!-- ========================================================= -->
    <!-- NBE SESSION -->
    <!-- ========================================================= -->

    <input type="hidden"
           id="SessionId"
           name="SesId"
           value="@ViewBag.Ses_Id" />


    <!-- ========================================================= -->
    <!-- NBE ORDER -->
    <!-- ========================================================= -->

    <input type="hidden"
           id="OrderId"
           name="OrdId"
           value="@ViewBag.Ord_Id" />


</body>
</html>
