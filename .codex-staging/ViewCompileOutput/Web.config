      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="recaptchaPublickey" value="6LdZiNAUAAAAAPn_KmWvRvlXAGwjodqC-hjtXbZL"/>
    <add key="recaptchaPrivatekey" value="6LdZiNAUAAAAAPUpO1b309qOpfBnBAqZavb10_uv"/>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!--<add key="SIP" value="10.5.1.30:8050" />-->
    <add key="SIP" value="localhost:49909" />
    <add key="ServerIP" value="10.10.91.14" />
    <!--<add key="ServerIP" value="10.7.7.242" />-->

    <add key="FolderName" value="plant_test" />
    <add key="PersonID" value="352" />

