@using System.Globalization
@using CapqWebDTO
@model SuccessfulPaymentDTO

@{
    Layout = null;
    var paymentDate = Model.PaymentDate.HasValue
        ? Model.PaymentDate.Value.ToString("dd/MM/yyyy")
        : (Model.CreationDate == default(DateTime)
            ? "-"
            : Model.CreationDate.ToString("dd/MM/yyyy"));
    var paymentTime = Model.CreationDate == default(DateTime)
        ? "-"
        : Model.CreationDate
            .ToString("hh:mm tt", CultureInfo.InvariantCulture)
            .Replace("AM", "ص")
            .Replace("PM", "م");
    var orderNumber = string.IsNullOrWhiteSpace(Model.OrderNumber)
        ? "-"
        : Model.OrderNumber;
    var transactionNumber = Model.ID.ToString(CultureInfo.InvariantCulture);
    var accountTypeName = Model.AccountType == 138
        ? "حكومي"
        : (Model.AccountType == 139 ? "خاص" : "-");
    const string emptyValue = "ــــــــ";
    Func<string, string> ValueOrDash = value =>
        string.IsNullOrWhiteSpace(value) ? emptyValue : value.Trim();
    Func<decimal?, string> FormatAmount = value =>
        value.HasValue ? value.Value.ToString("0.####", CultureInfo.InvariantCulture) : "-";
    var useCompactPrint = Model.Details.Count >= 9;
    var useDensePrint = Model.Details.Count >= 13;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>إيصال سداد إلكتروني - @orderNumber</title>
    <style>
        :root {
            --green: #00552f;
            --green-dark: #003c22;
            --green-deep: #002f1b;
            --gold: #c99b28;
            --line: #164e36;
            --soft-line: #c8d2cc;
            --ink: #111a15;
            --block-gap: 3mm;
        }

        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }

        body {
            background: #e6ece8;
            color: var(--ink);
            font-family: Tahoma, Arial, sans-serif;
            line-height: 1.4;
        }

        .receipt-shell {
            position: relative;
            width: min(210mm, calc(100% - 24px));
            min-height: 297mm;
            display: flex;
            flex-direction: column;
            margin: 24px auto 12px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 12px 38px rgba(0, 55, 31, .2);
        }

        .hero {
            position: relative;
            z-index: 2;
            flex: none;
            height: 72mm;
            display: grid;
            grid-template-columns: 1fr 2.5fr 1fr;
            direction: ltr;
            align-items: start;
            padding: 8mm 12mm 14mm;
            color: #fff;
            background-image:
                linear-gradient(90deg, rgba(0, 43, 25, .84), rgba(0, 62, 34, .55), rgba(0, 38, 23, .82)),
                url('/assets/payment-receipt/hero-fields.jpg');
            background-size: cover;
            background-position: center 43%;
            border-top: 1mm solid var(--green-deep);
        }

        .hero::after {
            content: "";
            position: absolute;
            z-index: 1;
            left: -4%;
            right: -4%;
            bottom: -9mm;
            height: 17mm;
            background: #fff;
            border-radius: 50% 50% 0 0 / 100% 100% 0 0;
            border-top: 1.2mm solid var(--gold);
        }

        .ministry-mark,
        .capq-mark,
        .hero-center {
            position: relative;
            z-index: 3;
        }

        .ministry-mark {
            direction: rtl;
            text-align: center;
            font-size: 9px;
            line-height: 1.5;
        }

        .eagle {
            display: block;
            width: 64px;
            height: 80px;
            margin: 0 auto 1px;
            object-fit: contain;
            filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .35));
        }

        .ministry-mark b { font-size: 10px; }
        .ministry-mark .en {
            display: block;
            direction: ltr;
            margin-top: 2px;
            font-size: 8px;
        }

        .capq-mark { text-align: right; }
        .capq-mark img {
            width: 110px;
            height: 110px;
            padding: 2px;
            object-fit: contain;
            background: rgba(255, 255, 255, .96);
            border-radius: 50%;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, .35));
        }

        .hero-center {
            direction: rtl;
            text-align: center;
            padding-top: 7mm;
            text-shadow: 0 2px 3px rgba(0, 0, 0, .45);
        }

        .authority-ar {
            display: block;
            font-size: 26px;
            font-weight: 800;
            line-height: 1.2;
        }

        .authority-en {
            display: block;
            direction: ltr;
            margin-top: 2px;
            font: 700 11px Arial, sans-serif;
            letter-spacing: .2px;
        }

        .receipt-title {
            margin: 9mm 0 0;
            color: #fff;
            font-size: 35px;
            line-height: 1;
            font-weight: 900;
        }

        .receipt-title-en {
            direction: ltr;
            margin-top: 2mm;
            color: #e4bd55;
            font: 700 15px Arial, sans-serif;
            letter-spacing: .6px;
            text-shadow: 0 1px 2px #173222;
        }

        .gold-ornament {
            width: 46mm;
            margin: 3mm auto 0;
            color: #dfb64a;
            font-size: 15px;
            line-height: 1;
            overflow: hidden;
            white-space: nowrap;
        }

        .paid-pill {
            position: absolute;
            z-index: 5;
            left: 50%;
            bottom: -13mm;
            transform: translateX(-50%);
            min-width: 61mm;
            height: 15mm;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 0 8mm;
            color: #fff;
            background: linear-gradient(135deg, #087943, #004528);
            border: 1px solid #003d22;
            border-radius: 30px;
            font-size: 18px;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0, 48, 28, .25);
        }

        .paid-check {
            width: 10mm;
            height: 10mm;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--green);
            background: #fff;
            border-radius: 50%;
            font-size: 23px;
            line-height: 1;
        }

        .receipt-content {
            position: relative;
            z-index: 1;
            flex: 1 0 auto;
            padding: 19mm 7mm 0;
        }

        .status-strip {
            display: grid;
            grid-template-columns: 1fr 1.1fr 1.1fr 1.1fr 1fr;
            direction: rtl;
            min-height: 24mm;
            margin-bottom: 8mm;
            padding: 3mm 2.5mm;
            overflow: hidden;
            background: rgba(255, 255, 255, .97);
            border: 1px solid #273d31;
            border-radius: 8px;
        }

        .status-item {
            min-width: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0 2mm;
            text-align: center;
            border-left: 1px dashed #7f9388;
        }

        .status-item:last-child { border-left: 0; }
        .icon {
            display: inline-block;
            width: 1em;
            height: 1em;
            object-fit: contain;
            vertical-align: -.12em;
        }

        .status-icon {
            width: 24px;
            height: 24px;
            object-fit: contain;
            opacity: .92;
        }

        .status-label { margin-top: 3px; color: #243a2e; font-size: 10px; font-weight: bold; }
        .status-value { margin-top: 2px; color: #050807; font-size: 11px; font-weight: bold; overflow-wrap: anywhere; }

        .status-item.boxed {
            padding: 0;
            border: 1px solid #718078;
            border-radius: 5px;
            overflow: hidden;
        }

        .status-item.boxed .status-label {
            width: 100%;
            margin: 0;
            padding: 2px 3px;
            color: #fff;
            background: linear-gradient(180deg, #096039, #004326);
            font-size: 10px;
        }

        .status-item.boxed .status-value {
            width: 100%;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2px;
            background: #fff;
            font-size: 11px;
        }

        .ltr { direction: ltr; unicode-bidi: embed; }

        .watermark {
            position: absolute;
            z-index: -1;
            top: 112mm;
            left: 50%;
            width: 105mm;
            height: 105mm;
            transform: translateX(-50%);
            object-fit: contain;
            opacity: .05;
            pointer-events: none;
        }

        .panel {
            position: relative;
            margin-bottom: 5.5mm;
            padding: 5.5mm 3mm 2mm;
            background: rgba(255, 255, 255, .82);
            border: 1px solid #304a3c;
            border-radius: 8px;
            break-inside: avoid;
        }

        .panel-title {
            position: absolute;
            top: -5mm;
            right: 0;
            min-width: 52mm;
            height: 9mm;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 6mm;
            color: #fff;
            background: linear-gradient(90deg, var(--green-dark), var(--green));
            border-radius: 7px 0 0 7px;
            font-size: 14px;
            font-weight: bold;
            box-shadow: 0 1px 2px rgba(0, 0, 0, .18);
        }

        .panel-title .icon {
            width: 16px;
            height: 16px;
            filter: brightness(0) invert(1);
        }

        .basic-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            direction: rtl;
            column-gap: 5mm;
        }

        .info-item {
            min-width: 0;
            min-height: 10.5mm;
            display: grid;
            grid-template-columns: 46% 54%;
            align-items: center;
            padding: 1px 2mm;
            border-bottom: 1px dotted #a7b4ad;
            font-size: 11px;
        }

        .info-item--wide {
            grid-column: 1 / -1;
            grid-template-columns: 24% 76%;
        }

        .info-item--certificate {
            grid-template-columns: 43% 57%;
        }

        .info-label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            color: #153f2c;
            font-weight: bold;
            text-align: center;
        }

        .info-label .icon {
            width: 17px;
            height: 17px;
            flex: 0 0 17px;
            opacity: .9;
        }
        .info-value {
            color: #0c120f;
            font-weight: bold;
            text-align: center;
            overflow-wrap: anywhere;
        }
        .info-value.is-empty { color: #6e7c74; text-align: center; letter-spacing: 1px; }

        .fees-panel {
            height: 62mm;
            display: flex;
            flex-direction: column;
            margin-bottom: var(--block-gap);
            padding: 5.5mm 3mm 2.5mm;
        }

        .fees-table {
            width: 100%;
            height: 100%;
            flex: 1 1 auto;
            table-layout: fixed;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 11px;
        }
        .fees-table th {
            padding: 5px 7px;
            color: #fff;
            background: linear-gradient(180deg, #08613a, #00452a);
            border-left: 1px solid rgba(255, 255, 255, .45);
        }

        .fees-table th:first-child { border-radius: 0 6px 0 0; }
        .fees-table th:last-child { border-left: 0; border-radius: 6px 0 0 0; }
        .fees-table td {
            padding: 4px 7px;
            text-align: center;
            border-left: 1px solid #cbd4cf;
            border-bottom: 1px solid #cbd4cf;
        }

        .fees-table td:first-child { border-right: 1px solid #cbd4cf; }
        .fees-table .fee-name { text-align: center; font-weight: bold; }
        .fees-table .fee-value { direction: ltr; font-family: Arial, sans-serif; font-weight: bold; }
        .fees-table .empty-row td { padding: 9px; color: #65736b; }
        .fees-total td {
            padding: 6px 10px;
            color: #fff;
            background: linear-gradient(90deg, #004126, #00643a);
            border: 0;
            font-size: 14px;
            font-weight: bold;
        }

        .fees-total td:first-child { border-radius: 0 0 6px 0; }
        .fees-total td:last-child { border-radius: 0 0 0 6px; }

        .signature-panel {
            min-height: 40mm;
            display: grid;
            grid-template-columns: 1.15fr .9fr 33mm;
            direction: rtl;
            align-items: stretch;
            margin-bottom: var(--block-gap);
            padding: 3mm 5mm;
            border: 1px solid #7a8981;
            border-radius: 8px;
            break-inside: avoid;
        }

        .receiver-signature {
            display: flex;
            flex-direction: column;
            justify-content: space-around;
            padding: 1mm 5mm;
            border-left: 1px solid #aeb9b3;
            font-size: 15px;
            font-weight: bold;
        }

        .signature-line { font-size: 13px; white-space: nowrap; }
        .electronic-copy {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 1mm 5mm;
            text-align: center;
            font-size: 9px;
        }

        .electronic-copy b {
            display: block;
            margin: 2mm 0;
            color: var(--green-dark);
            font-size: 12px;
        }

        .electronic-copy::after {
            content: "◆";
            display: block;
            width: 42mm;
            height: 4mm;
            margin: 2mm auto 0;
            color: var(--gold);
            background:
                linear-gradient(var(--gold), var(--gold)) left center / 44% 1px no-repeat,
                linear-gradient(var(--gold), var(--gold)) right center / 44% 1px no-repeat;
            font-size: 8px;
            line-height: 4mm;
            text-align: center;
        }

        .stamp-wrap { display: flex; align-items: center; justify-content: center; }
        .stamp {
            width: 28mm;
            height: 28mm;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--green-dark);
            background: #fff;
            border: 2px solid var(--green-dark);
            border-radius: 50%;
            box-shadow: inset 0 0 0 3px #fff, inset 0 0 0 4px var(--green-dark);
            transform: rotate(-7deg);
            font-size: 8px;
            font-weight: bold;
            line-height: 1.15;
        }

        .stamp-check { font-size: 24px; line-height: 1; }

        .green-footer {
            min-height: 18mm;
            flex: none;
            margin-top: auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1.6fr 24mm;
            direction: ltr;
            align-items: center;
            gap: 2mm;
            padding: 3mm 9mm;
            color: #fff;
            background: linear-gradient(90deg, #004326, #00613a, #003d24);
            border-top: 1.2mm solid var(--gold);
            font-size: 9px;
            text-align: center;
        }

        .green-footer .contact { direction: rtl; line-height: 1.5; }
        .footer-link { direction: ltr; white-space: nowrap; }
        .footer-link .icon {
            width: 15px;
            height: 15px;
            margin-right: 4px;
            filter: brightness(0) invert(1);
        }

        .footer-plant svg {
            display: block;
            width: 31px;
            height: 31px;
            margin: auto;
            color: #d5aa3b;
        }

        .actions { margin: 0 auto 24px; text-align: center; }
        .action-btn {
            min-width: 145px;
            margin: 0 5px;
            padding: 11px 22px;
            color: #fff;
            border: 0;
            border-radius: 7px;
            font: bold 15px Tahoma, Arial, sans-serif;
            cursor: pointer;
        }

        .print-btn { background: var(--green); }
        .back-btn { background: #68746d; }
        .action-btn:hover { filter: brightness(1.08); }

        @@page { size: A4 portrait; margin: 0; }

        @@media print {
            html, body { width: 210mm; background: #fff !important; }
            body { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
            .receipt-shell { width: 210mm; height: 297mm; min-height: 297mm; max-height: 297mm; margin: 0; box-shadow: none; }
            .actions { display: none !important; }

            .hero { height: 66mm; padding-top: 6mm; padding-bottom: 12mm; }
            .hero-center { padding-top: 5mm; }
            .authority-ar { font-size: 24px; }
            .receipt-title { margin-top: 7mm; font-size: 32px; }
            .capq-mark img { width: 96px; height: 96px; }
            .eagle { width: 56px; height: 70px; }
            .receipt-content { position: static; padding-top: 18mm; padding-bottom: 55mm; }
            .status-strip { margin-bottom: 7mm; }
            .panel { margin-bottom: 5mm; }
            .fees-table th,
            .fees-table td { padding-top: 2px; padding-bottom: 2px; }
            .signature-panel {
                position: absolute;
                right: 7mm;
                bottom: 20mm;
                left: 7mm;
                z-index: 9;
                height: 35mm;
                min-height: 35mm;
                margin: 0;
            }
            .fees-panel {
                position: absolute;
                right: 7mm;
                bottom: 58mm;
                left: 7mm;
                z-index: 8;
                height: 58mm;
                margin: 0;
            }
            .green-footer {
                position: absolute;
                right: 0;
                bottom: 0;
                left: 0;
                z-index: 10;
                height: 17mm;
                min-height: 17mm;
                margin: 0;
            }

            .receipt-shell.compact-print .hero { height: 58mm; padding-top: 4mm; padding-bottom: 9mm; }
            .receipt-shell.compact-print .hero-center { padding-top: 3mm; }
            .receipt-shell.compact-print .authority-ar { font-size: 20px; }
            .receipt-shell.compact-print .receipt-title { margin-top: 5mm; font-size: 26px; }
            .receipt-shell.compact-print .capq-mark img { width: 67px; height: 67px; }
            .receipt-shell.compact-print .eagle { width: 39px; height: 51px; }
            .receipt-shell.compact-print .paid-pill { bottom: -12mm; height: 13mm; font-size: 16px; }
            .receipt-shell.compact-print .paid-check { width: 8mm; height: 8mm; font-size: 19px; }
            .receipt-shell.compact-print .receipt-content { padding-top: 15mm; padding-bottom: 48mm; }
            .receipt-shell.compact-print .status-strip { min-height: 20mm; margin-bottom: 7mm; padding-top: 2mm; padding-bottom: 2mm; }
            .receipt-shell.compact-print .panel { margin-bottom: 5mm; }
            .receipt-shell.compact-print .info-item { min-height: 7.5mm; }
            .receipt-shell.compact-print .fees-table th,
            .receipt-shell.compact-print .fees-table td { padding-top: 2px; padding-bottom: 2px; }
            .receipt-shell.compact-print .fees-total td { padding-top: 4px; padding-bottom: 4px; }
            .receipt-shell.compact-print .fees-panel { bottom: 52mm; height: 54mm; margin: 0; }
            .receipt-shell.compact-print .signature-panel { bottom: 18mm; height: 31mm; min-height: 31mm; }
            .receipt-shell.compact-print .stamp { width: 24mm; height: 24mm; }
            .receipt-shell.compact-print .green-footer { height: 15mm; min-height: 15mm; padding-top: 2mm; padding-bottom: 2mm; }

            .receipt-shell.dense-print .hero { height: 53mm; }
            .receipt-shell.dense-print .authority-ar { font-size: 18px; }
            .receipt-shell.dense-print .receipt-title { margin-top: 3mm; font-size: 23px; }
            .receipt-shell.dense-print .receipt-title-en,
            .receipt-shell.dense-print .gold-ornament { margin-top: 1mm; }
            .receipt-shell.dense-print .receipt-content { padding-top: 14mm; padding-bottom: 44mm; }
            .receipt-shell.dense-print .status-strip { min-height: 17mm; margin-bottom: 7mm; }
            .receipt-shell.dense-print .info-item { min-height: 6.5mm; }
            .receipt-shell.dense-print .fees-panel { bottom: 48mm; height: 50mm; }
            .receipt-shell.dense-print .signature-panel { bottom: 18mm; height: 27mm; min-height: 27mm; }
            .receipt-shell.dense-print .electronic-copy { font-size: 8px; }
        }

        @@media (max-width: 720px) {
            .receipt-shell { width: 100%; min-height: 0; margin-top: 0; }
            .hero { height: 68mm; grid-template-columns: .85fr 2.2fr .85fr; padding-left: 4mm; padding-right: 4mm; }
            .authority-ar { font-size: 18px; }
            .authority-en { font-size: 7px; }
            .receipt-title { font-size: 23px; }
            .receipt-title-en { font-size: 10px; }
            .capq-mark img { width: 60px; height: 60px; }
            .eagle { width: 36px; height: 48px; }
            .ministry-mark { font-size: 6px; }
            .status-strip { grid-template-columns: repeat(2, 1fr); }
            .status-item { min-height: 18mm; border-bottom: 1px dashed #7f9388; }
            .status-item:first-child { grid-column: 1 / -1; }
            .basic-grid { grid-template-columns: 1fr; }
            .signature-panel { grid-template-columns: 1fr; gap: 3mm; }
            .receiver-signature { min-height: 25mm; border-left: 0; border-bottom: 1px solid #aeb9b3; }
            .green-footer { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>
    <main class="receipt-shell @(useCompactPrint ? "compact-print" : "") @(useDensePrint ? "dense-print" : "")" id="receipt">
        <header class="hero">
            <div class="ministry-mark">
                <img class="eagle" src="/assets/payment-receipt/egypt-coat-of-arms.svg" alt="شعار جمهورية مصر العربية" />
                <b>جمهورية مصر العربية</b><br />
                وزارة الزراعة واستصلاح الأراضي
                <span class="en">Ministry of Agriculture and Land Reclamation</span>
            </div>

            <div class="hero-center">
                <span class="authority-ar">الإدارة المركزية للحجر الزراعي</span>
                <span class="authority-en">CENTRAL ADMINISTRATION OF PLANT QUARANTINE</span>
                <h1 class="receipt-title">إيصال سداد إلكتروني</h1>
                <div class="receipt-title-en">ELECTRONIC PAYMENT RECEIPT</div>
                <div class="gold-ornament">──── ❦ ────</div>
            </div>

            <div class="capq-mark">
                <img src="/assets/payment-receipt/logo-capq.png" alt="شعار الإدارة المركزية للحجر الزراعي" />
            </div>

            <div class="paid-pill">
                <span class="paid-check">✓</span>
                <span>تم السداد بنجاح</span>
            </div>
        </header>

        <div class="receipt-content">
            <section class="status-strip" aria-label="بيانات عملية السداد">
                <div class="status-item boxed">
                    <span class="status-label">رقم الطلب</span>
                    <span class="status-value ltr">@orderNumber</span>
                </div>
                <div class="status-item">
                    <img class="status-icon" src="/assets/payment-receipt/icons/regular/calendar-alt.svg" alt="" />
                    <span class="status-label">تاريخ السداد</span>
                    <span class="status-value ltr">@paymentDate</span>
                </div>
                <div class="status-item">
                    <img class="status-icon" src="/assets/payment-receipt/icons/regular/clock.svg" alt="" />
                    <span class="status-label">وقت السداد</span>
                    <span class="status-value">@paymentTime</span>
                </div>
                <div class="status-item">
                    <img class="status-icon" src="/assets/payment-receipt/icons/regular/credit-card.svg" alt="" />
                    <span class="status-label">نوع حساب الدفع</span>
                    <span class="status-value">@accountTypeName</span>
                </div>
                <div class="status-item boxed">
                    <span class="status-label">رقم العملية</span>
                    <span class="status-value ltr">@transactionNumber</span>
                </div>
            </section>

            <img class="watermark" src="/assets/payment-receipt/logo-capq.png" alt="" aria-hidden="true" />

            <section class="panel">
                <div class="panel-title"><img class="icon" src="/assets/payment-receipt/icons/solid/user.svg" alt="" /> البيانات الأساسية</div>
                <div class="basic-grid">
                    <div class="info-item info-item--wide"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/solid/building.svg" alt="" />مكتب الحجر الزراعي</span><span class="info-value @(string.IsNullOrWhiteSpace(Model.Office) ? "is-empty" : "")">@ValueOrDash(Model.Office)</span></div>
                    <div class="info-item info-item--wide info-item--certificate"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/solid/clipboard-list.svg" alt="" />رقم الشهادة الجمركية / رقم طلب الفحص / رقم العينة</span><span class="info-value ltr @(string.IsNullOrWhiteSpace(Model.CustomsCertificateNumber) ? "is-empty" : "")">@ValueOrDash(Model.CustomsCertificateNumber)</span></div>
                    <div class="info-item"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/solid/sitemap.svg" alt="" />القسم</span><span class="info-value @(string.IsNullOrWhiteSpace(Model.Department) ? "is-empty" : "")">@ValueOrDash(Model.Department)</span></div>
                    <div class="info-item"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/solid/seedling.svg" alt="" />الصنف</span><span class="info-value @(string.IsNullOrWhiteSpace(Model.Item) ? "is-empty" : "")">@ValueOrDash(Model.Item)</span></div>
                    <div class="info-item"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/solid/city.svg" alt="" />اسم الشركة</span><span class="info-value @(string.IsNullOrWhiteSpace(Model.Name) ? "is-empty" : "")">@ValueOrDash(Model.Name)</span></div>
                    <div class="info-item"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/solid/anchor.svg" alt="" />اسم المحطة</span><span class="info-value @(string.IsNullOrWhiteSpace(Model.FarmName) ? "is-empty" : "")">@ValueOrDash(Model.FarmName)</span></div>
                    <div class="info-item"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/regular/id-card.svg" alt="" />الرقم القومي</span><span class="info-value ltr @(string.IsNullOrWhiteSpace(Model.NationalID) ? "is-empty" : "")">@ValueOrDash(Model.NationalID)</span></div>
                    <div class="info-item"><span class="info-label"><img class="icon" src="/assets/payment-receipt/icons/solid/book.svg" alt="" />رقم السجل (الدفتر)</span><span class="info-value ltr @(string.IsNullOrWhiteSpace(Model.LedgerNumber) ? "is-empty" : "")">@ValueOrDash(Model.LedgerNumber)</span></div>
                </div>
            </section>

            <section class="panel fees-panel">
                <div class="panel-title"><img class="icon" src="/assets/payment-receipt/icons/solid/coins.svg" alt="" /> تفاصيل الرسوم</div>
                <table class="fees-table">
                    <thead>
                        <tr>
                            <th style="width:8%">م</th>
                            <th>نوع الرسم</th>
                            <th style="width:14%">العدد</th>
                            <th style="width:23%">القيمة (ج.م)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Details.Count == 0)
                        {
                            <tr class="empty-row"><td colspan="4">لا توجد بنود رسوم مسجلة</td></tr>
                        }
                        else
                        {
                            for (var i = 0; i < Model.Details.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td class="fee-name">@(Model.Details[i].FeesTypeName ?? "-")</td>
                                    <td>@(Model.Details[i].Quantity.HasValue ? Model.Details[i].Quantity.Value.ToString(CultureInfo.InvariantCulture) : "-")</td>
                                    <td class="fee-value">@FormatAmount(Model.Details[i].Amount)</td>
                                </tr>
                            }
                        }
                        <tr class="fees-total">
                            <td colspan="3">الإجمالي</td>
                            <td class="ltr">@FormatAmount(Model.TotalAmount) ج.م</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="signature-panel">
                <div class="receiver-signature">
                    <div>توقيع المهندس مستلم الإيصال</div>
                    <div class="signature-line">التوقيع: ............................</div>
                </div>
                <div class="electronic-copy">
                    هذا إيصال إلكتروني صادر عن
                    <b>الإدارة المركزية للحجر الزراعي</b>
                    ولا يحتاج إلى توقيع أو ختم.
                </div>
                <div class="stamp-wrap">
                    <div class="stamp">
                        <span>تم السداد</span>
                        <span class="stamp-check">✓</span>
                        <span>إلكترونيًا</span>
                    </div>
                </div>
            </section>
        </div>

        <footer class="green-footer">
            <div class="footer-link"><img class="icon" src="/assets/payment-receipt/icons/solid/globe.svg" alt="" />www.capq.gov.eg</div>
            <div class="footer-link"><img class="icon" src="/assets/payment-receipt/icons/regular/envelope.svg" alt="" />info@capq.gov.eg</div>
            <div class="contact">في حالة وجود أي استفسار يرجى التواصل<br />عبر القنوات الرسمية للإدارة</div>
            <div class="footer-plant" aria-hidden="true">
                <svg viewBox="0 0 48 48" role="img">
                    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M24 43V20" />
                        <path d="M24 29C17 29 12 25 11 18c7 0 12 3 13 9" />
                        <path d="M24 35c7 0 12-4 13-11-7 0-12 3-13 9" />
                        <path d="M24 22c-5-3-7-8-5-14 5 2 8 6 7 12" />
                        <path d="M25 21c5-2 8-7 8-13-5 1-9 5-9 11" />
                        <path d="M18 43h12" />
                    </g>
                </svg>
            </div>
        </footer>
    </main>

    <div class="actions">
        <button type="button" class="action-btn print-btn" onclick="window.print()"><img class="icon" src="/assets/payment-receipt/icons/solid/print.svg" alt="" /> طباعة الإيصال</button>
        <button type="button" class="action-btn back-btn" onclick="window.location.href='@Url.Action(Model.AccountType == 139 ? "PrivatePayments" : "GovernmentPayments")'"><img class="icon" src="/assets/payment-receipt/icons/solid/undo-alt.svg" alt="" /> رجوع</button>
    </div>

    @if (ViewData["AutoPrint"] as bool? == true)
    {
        <script>
            window.addEventListener('load', function () { window.print(); });
        </script>
    }
</body>
</html>
